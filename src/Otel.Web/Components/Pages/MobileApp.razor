    async Task CheckInReservation(Reservation res)
    {
        res.Status = ResStatus.CheckedIn;
        var rm = res.Rooms.FirstOrDefault()?.Room;
        if (rm != null)
        {
            occupiedRoomIds.Add(rm.Id);
        }
        await Db.SaveChangesAsync();
        await LoadHotelDataAsync();
    }

    async Task CheckOutReservation(Reservation res)
    {
        res.Status = ResStatus.CheckedOut;
        var rm = res.Rooms.FirstOrDefault()?.Room;
        if (rm != null)
        {
            occupiedRoomIds.Remove(rm.Id);
            rm.Housekeeping = HkStatus.Dirty;
        }
        await Db.SaveChangesAsync();
        await LoadHotelDataAsync();
    }

