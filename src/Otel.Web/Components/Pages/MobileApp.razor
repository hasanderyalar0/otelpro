            new("Yeni Yüksek Rezervasyon", "Booking.com üzerinden ₺36.400 tutarında 4 gecelik rezervasyon onaylandı.", "25 dk önce", "💰", "#34d399"),
            new("Teknik Servis Uyarısı", "Oda 202 klima filtre temizliği iş emri açıldı.", "1 saat önce", "🛠️", "#f59e0b"),
