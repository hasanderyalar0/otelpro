    async Task SaveQuickReservation()
    {
        if (string.IsNullOrWhiteSpace(newResGuestName)) return;

        var guest = new Guest
        {
            FirstName = newResGuestName.Trim(),
            LastName = "",
            Phone = newResGuestPhone,
            Nationality = "TR"
        };
        Db.Guests.Add(guest);
        await Db.SaveChangesAsync();

        var selectedRt = hotelRoomTypes.FirstOrDefault(rt => rt.Id == newResRoomTypeId) ?? hotelRoomTypes.FirstOrDefault();
        var freeRoom = hotelRooms.FirstOrDefault(r => r.RoomTypeId == selectedRt?.Id && !occupiedRoomIds.Contains(r.Id));

        var today = DateTime.Today;
        var total = (selectedRt?.BasePrice ?? 3000) * newResNights;

        var res = new Reservation
        {
            Code = $"MOB{new Random().Next(1000, 9999)}",
            GuestId = guest.Id,
            CheckIn = today,
            CheckOut = today.AddDays(newResNights),
            Adults = 2,
            TotalAmount = total,
            Status = ResStatus.Confirmed,
            CreatedAt = DateTime.Now
        };

        if (freeRoom != null)
        {
            res.Rooms.Add(new ReservationRoom
            {
                RoomTypeId = selectedRt?.Id ?? 1,
                RoomId = freeRoom.Id,
                CheckIn = today,
                CheckOut = today.AddDays(newResNights),
                NightlyRate = selectedRt?.BasePrice ?? 3000
            });
        }

        Db.Reservations.Add(res);
        await Db.SaveChangesAsync();

        showQuickBookSheet = false;
        newResGuestName = "";
        newResGuestPhone = "";
        await LoadHotelDataAsync();
    }

