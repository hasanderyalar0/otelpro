    static string FormatWhatsApp(string phone)
    {
        if (string.IsNullOrWhiteSpace(phone)) return "";
        var digits = new string(phone.Where(char.IsDigit).ToArray());
        if (digits.StartsWith("0")) digits = "90" + digits.Substring(1);
        if (!digits.StartsWith("90") && digits.Length == 10) digits = "90" + digits;
        return digits;
    }

    async Task LoadCalendarMonthDataAsync()
    {
        var start = calMonth;
        var end = calMonth.AddMonths(1);

        calMonthResRooms = await Db.ReservationRooms
            .Include(rr => rr.Room).ThenInclude(rm => rm!.RoomType)
            .Include(rr => rr.Room).ThenInclude(rm => rm!.Floor)
            .Include(rr => rr.Reservation).ThenInclude(r => r!.Guest)
            .Include(rr => rr.Reservation).ThenInclude(r => r!.Folio).ThenInclude(f => f!.Payments)
            .Include(rr => rr.Reservation).ThenInclude(r => r!.Channel)
            .Where(rr => rr.RoomId != null
                && rr.Room!.HotelId == selectedHotelId
                && rr.Reservation!.Status != ResStatus.Cancelled
                && rr.Reservation.Status != ResStatus.NoShow
                && rr.CheckIn < end && rr.CheckOut > start)
            .ToListAsync();

        RecalculateMonthStats();
    }

    void RecalculateMonthStats()
    {
        int days = calDaysInMonth;
        int totalPossibleRoomNights = hotelRooms.Count * days;
        int totalOccupiedRoomNights = 0;
        decimal totalRev = 0;
        int maxDayOccupied = -1;
        DateTime peakDay = calMonth;

        for (int d = 1; d <= days; d++)
        {
            var dt = new DateTime(calMonth.Year, calMonth.Month, d);
            var activeRrs = calMonthResRooms.Where(rr => rr.CheckIn.Date <= dt.Date && rr.CheckOut.Date > dt.Date).ToList();
            var occCount = activeRrs.Select(rr => rr.RoomId).Distinct().Count();
            totalOccupiedRoomNights += occCount;

            foreach (var rr in activeRrs)
            {
                totalRev += rr.NightlyRate > 0 ? rr.NightlyRate : 3000m;
            }

            if (occCount > maxDayOccupied)
            {
                maxDayOccupied = occCount;
                peakDay = dt;
            }
        }

        calTotalNights = totalOccupiedRoomNights;
        calAvgOccupancy = totalPossibleRoomNights > 0 ? Math.Round((double)totalOccupiedRoomNights / totalPossibleRoomNights * 100, 1) : 0;
        calTotalRevenue = totalRev;
        var peakPct = hotelRooms.Count > 0 ? Math.Round((double)maxDayOccupied / hotelRooms.Count * 100, 0) : 0;
        calPeakDayInfo = $"{peakDay.ToString("dd MMM", L.Culture)} (%{peakPct})";
    }

