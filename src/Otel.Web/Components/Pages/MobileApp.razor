    List<RoomType> hotelRoomTypes = new();
    List<Channel> channels = new();

    List<Reservation> todayArrivals = new();
    List<Reservation> todayDepartures = new();
    HashSet<int> occupiedRoomIds = new();

    string currentTab = "dash";
    bool isFullScreenMode = false;
    bool loading = true;
    int selectedFloorFilter = 0;

    // Flash KPI'lar
    double occupancyPct = 0;
    int inHouseRooms = 0;
    int totalRooms = 0;
    int todayArrivalsCount = 0;
    int todayDeparturesCount = 0;
    int dirtyRoomsCount = 0;
    int cleanRoomsCount = 0;
    decimal todayRevenue = 0;
    decimal adr = 0;
    decimal cashBalance = 38400;
    bool isStopSellActive = false;

    // Sheet Gösterimleri
    bool showFabActionSheet = false;
    bool showQuickBookSheet = false;
    bool showQuickRateSheet = false;
    bool showMaintenanceSheet = false;
    bool showHotelPickerSheet = false;
    bool showPwaGuideModal = false;
    bool showAiCopilotSheet = false;

    // AI Değişkenleri
    string mobileAiInput = "";
    bool isMobileAiThinking = false;
    bool isTrainingMobile = false;
    int highRiskCancelCount = 2;
    double avgWeekendOcc = 88;
    List<CopilotMessage> mobileAiMessages = new();

    // Formlar
    string newResGuestName = "";
    string newResGuestPhone = "";
    int newResRoomTypeId = 0;
    int newResNights = 2;

    int maintRoomId = 0;
    string maintTitle = "";

    record MobileNotification(string Title, string Message, string Time, string Icon, string Color);
    List<MobileNotification> notifications = new();
    int unreadNotificationsCount = 3;

    IEnumerable<Room> FilteredRooms => hotelRooms
        .Where(r => selectedFloorFilter == 0 || r.FloorId == selectedFloorFilter);

    // Aylık Çizelge & Oda Takvimi Değişkenleri
    DateTime calMonth = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    DateTime selectedCalDate = DateTime.Today;
    string calViewMode = "grid"; // "grid" | "tape"
    string calDayFilter = "all"; // "all" | "occupied" | "available" | "arrivals" | "departures"
    int calRoomTypeFilter = 0;
    List<ReservationRoom> calMonthResRooms = new();
    Reservation? selectedResDetail = null;
    bool showResDetailSheet = false;

    int calDaysInMonth => DateTime.DaysInMonth(calMonth.Year, calMonth.Month);
    int calFirstDayOffset => ((int)new DateTime(calMonth.Year, calMonth.Month, 1).DayOfWeek + 6) % 7;
    double calAvgOccupancy = 0;
    int calTotalNights = 0;
    decimal calTotalRevenue = 0;
    string calPeakDayInfo = "";

    List<ReservationRoom> SelectedDayActiveResRooms => calMonthResRooms
        .Where(rr => rr.CheckIn.Date <= selectedCalDate.Date && rr.CheckOut.Date > selectedCalDate.Date)
        .ToList();

    int SelectedDayOccupiedCount => SelectedDayActiveResRooms.Select(rr => rr.RoomId).Distinct().Count();

    double SelectedDayOccPct => hotelRooms.Count > 0 
        ? Math.Min(100, Math.Round((double)SelectedDayOccupiedCount / hotelRooms.Count * 100, 0)) 
        : 0;

    int SelectedDayArrivalsCount => calMonthResRooms.Count(rr => rr.CheckIn.Date == selectedCalDate.Date);
    int SelectedDayDeparturesCount => calMonthResRooms.Count(rr => rr.CheckOut.Date == selectedCalDate.Date);

    IEnumerable<Room> FilteredDayRooms
    {
        get
        {
            var list = hotelRooms.AsEnumerable();
            if (calRoomTypeFilter > 0)
            {
                list = list.Where(r => r.RoomTypeId == calRoomTypeFilter);
            }

            if (calDayFilter == "occupied")
            {
                var occIds = SelectedDayActiveResRooms.Select(x => x.RoomId).ToHashSet();
                list = list.Where(r => occIds.Contains(r.Id));
            }
            else if (calDayFilter == "available")
            {
                var occIds = SelectedDayActiveResRooms.Select(x => x.RoomId).ToHashSet();
                list = list.Where(r => !occIds.Contains(r.Id));
            }
            else if (calDayFilter == "arrivals")
            {
                var arrIds = calMonthResRooms.Where(x => x.CheckIn.Date == selectedCalDate.Date).Select(x => x.RoomId).ToHashSet();
                list = list.Where(r => arrIds.Contains(r.Id));
            }
            else if (calDayFilter == "departures")
            {
                var depIds = calMonthResRooms.Where(x => x.CheckOut.Date == selectedCalDate.Date).Select(x => x.RoomId).ToHashSet();
                list = list.Where(r => depIds.Contains(r.Id));
            }

            return list;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CurrentHotelState.InitAsync();
        hotels = await Db.Hotels.AsNoTracking().OrderBy(h => h.Id).ToListAsync();

        selectedHotelId = CurrentHotelState.SelectedHotelId > 0 ? CurrentHotelState.SelectedHotelId : (hotels.FirstOrDefault()?.Id ?? 1);
        await LoadHotelDataAsync();
        GenerateNotifications();
    }

    async Task LoadHotelDataAsync()
    {
        loading = true;
        currentHotel = hotels.FirstOrDefault(h => h.Id == selectedHotelId);
        hotelRooms = await Db.Rooms.Where(r => r.HotelId == selectedHotelId).Include(r => r.RoomType).Include(r => r.Floor).OrderBy(r => r.Number).ToListAsync();
        hotelFloors = await Db.Floors.Where(f => f.HotelId == selectedHotelId).OrderBy(f => f.Number).ToListAsync();
        hotelRoomTypes = await Db.RoomTypes.Where(rt => rt.HotelId == selectedHotelId).ToListAsync();
        channels = await Db.Channels.OrderBy(c => c.Name).ToListAsync();

        if (hotelRoomTypes.Count > 0 && newResRoomTypeId == 0)
        {
            newResRoomTypeId = hotelRoomTypes[0].Id;
        }
        if (hotelRooms.Count > 0 && maintRoomId == 0)
        {
            maintRoomId = hotelRooms[0].Id;
        }

        var today = DateTime.Today;

        // In-house & Occupancy
        var inHouse = await Db.Reservations
            .Include(r => r.Guest)
            .Include(r => r.Rooms).ThenInclude(rm => rm.Room)
            .Where(r => r.Status == ResStatus.CheckedIn && r.Rooms.Any(rm => rm.Room!.HotelId == selectedHotelId))
            .ToListAsync();

        occupiedRoomIds = inHouse
            .SelectMany(r => r.Rooms)
            .Where(rm => rm.RoomId.HasValue && rm.Room!.HotelId == selectedHotelId)
            .Select(rm => rm.RoomId!.Value)
            .ToHashSet();

        totalRooms = hotelRooms.Count(r => r.Status != RoomStatus.OutOfOrder);
        inHouseRooms = occupiedRoomIds.Count;
        occupancyPct = totalRooms > 0 ? Math.Round((double)inHouseRooms / totalRooms * 100, 1) : 0;

        // Arrivals (Girişler)
        todayArrivals = await Db.Reservations
            .Include(r => r.Guest)
            .Include(r => r.Rooms).ThenInclude(rm => rm.Room)
            .Where(r => r.CheckIn == today && r.Status == ResStatus.Confirmed && r.Rooms.Any(rm => rm.Room!.HotelId == selectedHotelId))
            .ToListAsync();
        todayArrivalsCount = todayArrivals.Count;

        // Departures (Çıkışlar)
        todayDepartures = await Db.Reservations
            .Include(r => r.Guest)
            .Include(r => r.Rooms).ThenInclude(rm => rm.Room)
            .Include(r => r.Folio).ThenInclude(f => f!.Payments)
            .Where(r => r.CheckOut == today && r.Status == ResStatus.CheckedIn && r.Rooms.Any(rm => rm.Room!.HotelId == selectedHotelId))
            .ToListAsync();
        todayDeparturesCount = todayDepartures.Count;

        // Housekeeping
        dirtyRoomsCount = hotelRooms.Count(r => r.Housekeeping == HkStatus.Dirty);
        cleanRoomsCount = hotelRooms.Count(r => r.Housekeeping == HkStatus.Clean);

        // Revenue (Bugünkü Ciro)
        var dashStats = await Reports.StatsAsync(selectedHotelId);
        todayRevenue = inHouse.Sum(r => r.TotalAmount / Math.Max(1, (r.CheckOut - r.CheckIn).Days));
        if (todayRevenue <= 0) todayRevenue = inHouseRooms * 3200m;
        adr = inHouseRooms > 0 ? Math.Round(todayRevenue / inHouseRooms, 0) : 3200m;

        try
        {
            var risks = await Ml.ScanUpcomingCancellationRisksAsync(Db, selectedHotelId);
            highRiskCancelCount = risks.Count(r => r.CancelProbability >= 60);

            var fc = await Ai.GenerateOccupancyForecastAsync(7, selectedHotelId);
            var wk = fc.Where(f => f.Date.DayOfWeek == DayOfWeek.Friday || f.Date.DayOfWeek == DayOfWeek.Saturday).ToList();
            if (wk.Count > 0) avgWeekendOcc = Math.Round(wk.Average(f => f.PredictedOccupancyPct), 0);
        }
        catch { }

        await LoadCalendarMonthDataAsync();
        loading = false;
    }

    void OpenAiAssistantFromFab()
    {
        showFabActionSheet = false;
        showAiCopilotSheet = true;
        if (mobileAiMessages.Count == 0)
        {
            mobileAiMessages.Add(new CopilotMessage("assistant", $"Merhaba Patron! Ben **OtelPro AI Copilot**. {currentHotel?.Name} için doluluk, iptal riski, fiyat optimizasyonu ve model eğitimi konularında 7/24 hizmetinizdeyim.", DateTime.Now));
        }
    }

    async Task SendMobileAiQuery(string query)
    {
        mobileAiInput = query;
        await SubmitMobileAiQuery();
    }

    async Task SubmitMobileAiQuery()
    {
        if (string.IsNullOrWhiteSpace(mobileAiInput) || isMobileAiThinking) return;
        var q = mobileAiInput.Trim();
        mobileAiInput = "";

        mobileAiMessages.Add(new CopilotMessage("user", q, DateTime.Now));
        isMobileAiThinking = true;
        StateHasChanged();

        try
        {
            var res = await Copilot.ProcessQueryAsync(q, selectedHotelId, "staff");
            mobileAiMessages.Add(res);
        }
        catch (Exception ex)
        {
            mobileAiMessages.Add(new CopilotMessage("assistant", $"⚠️ Hata: {ex.Message}", DateTime.Now));
        }
        finally
        {
            isMobileAiThinking = false;
            StateHasChanged();
        }
    }

    async Task HandleMobileAiKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SubmitMobileAiQuery();
    }

    async Task TrainModelFromMobile()
    {
        isTrainingMobile = true;
        StateHasChanged();
        await Task.Delay(300);
        await Ml.TrainCancellationModelAsync(Db, 300);
        var risks = await Ml.ScanUpcomingCancellationRisksAsync(Db, selectedHotelId);
        highRiskCancelCount = risks.Count(r => r.CancelProbability >= 60);
        isTrainingMobile = false;
        mobileAiMessages.Add(new CopilotMessage("assistant", $"🧠 **FastTree Modeli Başarıyla Eğitildi!**\n• Örnek: {Ml.TrainingSampleCount} rezervasyon\n• Doğruluk: %{Ml.ModelAccuracy}\n• AUC: {Ml.AreaUnderRocCurve}", DateTime.Now));
        StateHasChanged();
    }

