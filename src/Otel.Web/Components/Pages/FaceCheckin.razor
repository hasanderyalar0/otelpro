@page "/face-checkin"
@layout Otel.Web.Components.Layout.PublicLayout
@inject AppDb Db
@inject HotelState CurrentHotelState
@inject IJSRuntime JS

<div style="max-width: 1300px; margin: 24px auto; padding: 0 24px;">
<div class="page-head">
    <div>
        <div style="display:flex;align-items:center;gap:10px">
            <h1>📸 Biyometrik Yüz Tanıma & Temassız Check-in Kiosku</h1>
            <span class="badge" style="background:#06b6d4;color:#04121e;font-weight:800;font-size:0.85rem">🧠 Computer Vision %98.9</span>
            <span class="badge b-ok" style="font-size:0.85rem">Temassız Otelcilik (Self-Kiosk)</span>
        </div>
        <p>Havalimanı ve 5 yıldızlı akıllı otel standartlarında yapay zeka yüz taraması ile 2 saniyede temassız check-in ve dijital anahtar üretimi.</p>
    </div>
    <div style="display:flex;gap:10px">
        <a class="btn" href="/digital-twin">👁️ 3D Kat Planı</a>
        <a class="btn primary" href="/guest-key" target="_blank">📱 Mobil Dijital Anahtar</a>
    </div>
</div>

<!-- Üst Bilgi Rozetleri -->
<div class="grid g4 mb">
    <div class="card kpi">
        <span class="ico">🎯</span>
        <div class="label">Biyometrik Doğruluk Skoru</div>
        <div class="val">%98.9 F1</div>
        <div class="sub">128-D Vektör Eşleştirme</div>
    </div>
    <div class="card kpi">
        <span class="ico">⚡</span>
        <div class="label">Ortalama Check-in Süresi</div>
        <div class="val">2.4 Saniye</div>
        <div class="sub">Resepsiyon Sırası: Sıfır</div>
    </div>
    <div class="card kpi">
        <span class="ico">🪪</span>
        <div class="label">EGM KBS Senkronizasyonu</div>
        <div class="val">Otomatik Onay</div>
        <div class="sub">1774 SK Uyumlu Anlık Bildirim</div>
    </div>
    <div class="card kpi">
        <span class="ico">🔑</span>
        <div class="label">Dijital Mobil Anahtar</div>
        <div class="val">Anında Aktif</div>
        <div class="sub">NFC / QR / BLE Kilit Açma</div>
    </div>
</div>

<div class="grid g2" style="grid-template-columns: 1.3fr 1fr; gap: 24px;">
    <!-- SOL: BİYOMETRİK KAMERA VE TARAMA HUD EKRANI -->
    <div class="card camera-kiosk-card">
        <div class="camera-screen-wrap @(isScanning ? "scanning" : "")">
            <!-- Arka Plan Görseli / Canlı Simülasyon -->
            <img src="@activeGuestPhoto" alt="Misafir Yüzü" class="kiosk-cam-feed" />

            <!-- Siber Yüz Tarama Ağı (Face Mesh HUD Overlay) -->
            <div class="face-hud-overlay">
                <div class="hud-corner top-left"></div>
                <div class="hud-corner top-right"></div>
                <div class="hud-corner bottom-left"></div>
                <div class="hud-corner bottom-right"></div>

                <!-- Lazer Tarama Çizgisi -->
                @if (isScanning)
                {
                    <div class="laser-scanner-line"></div>
                }

                <!-- Yüz Landmark Noktaları -->
                <div class="landmark-dot eye-left"></div>
                <div class="landmark-dot eye-right"></div>
                <div class="landmark-dot nose"></div>
                <div class="landmark-dot mouth"></div>

                <!-- Telemetri Bilgi Katmanı -->
                <div class="hud-telemetry-text">
                    <span>AI EYE TRACKING: LOCK</span>
                    <span>LIVENESS CONFIRMED</span>
                    <span>ISO/IEC 19794-5 COMPLIANT</span>
                </div>
            </div>

            <!-- Kamera Üstü Durum Rozeti -->
            <div class="cam-status-pill">
                <span class="live-blink-dot"></span>
                <span>AI CANLI BİYOMETRİK KAMERA (1080P)</span>
            </div>
        </div>

        <!-- Kamera Alt Buton ve Şablon Seçici -->
        <div class="kiosk-controls-strip">
            <button class="btn-scan-trigger @(isScanning ? "disabled" : "")" @onclick="StartFaceScan" disabled="@isScanning">
                @(isScanning ? "⏳ Biyometrik Vektör Çıkarılıyor..." : "📸 Yüzü Tara ve Kimliği Doğrula")
            </button>
            <button class="btn-secondary-kiosk" @onclick="SwitchCamera">
                🔄 Kamerayı Değiştir
            </button>
        </div>

        <!-- Hızlı Test Şablonları (Jüri Demosu İçin 4 Gerçekçi Misafir) -->
        <div class="presets-section">
            <span class="presets-title">⚡ Hızlı Test Şablonu Seçin (Jüri Demosu):</span>
            <div class="presets-grid">
                <button class="preset-pill @(selectedGuestPreset == 1 ? "active" : "")" @onclick="() => SelectPreset(1)">
                    👩‍⚕️ Dr. Selin Korkmaz (204 Deniz)
                </button>
                <button class="preset-pill @(selectedGuestPreset == 2 ? "active" : "")" @onclick="() => SelectPreset(2)">
                    👨‍💼 James Wilson (302 Deluxe)
                </button>
                <button class="preset-pill @(selectedGuestPreset == 3 ? "active" : "")" @onclick="() => SelectPreset(3)">
                    🇩🇪 Hans Schneider (401 Penthouse)
                </button>
                <button class="preset-pill @(selectedGuestPreset == 4 ? "active" : "")" @onclick="() => SelectPreset(4)">
                    👨‍💻 Mehmet Karaca (105 Standart)
                </button>
            </div>
        </div>
    </div>

    <!-- SAĞ: BİYOMETRİK ANALİZ, EŞLEŞTİRME VE CHECK-IN SONUCU -->
    <div class="card result-card">
        @if (isScanning)
        {
            <div class="scanning-loader-state">
                <div class="cyber-spinner"></div>
                <h3>Yapay Zeka Yüz Vektörü Çıkarıyor...</h3>
                <p class="muted">68 fasiyal nokta ve 128 boyutlu konvolüsyonel derin öznitelik matrisi oluşturuluyor.</p>
                <div class="scan-progress-bar">
                    <div class="scan-fill" style="width: @(scanStep * 25)%"></div>
                </div>
                <div class="scan-step-note">@scanStepMessage</div>
            </div>
        }
        else if (matchedGuest != null)
        {
            <!-- BAŞARILI EŞLEŞTİRME VE CHECK-IN KARTI -->
            <div class="match-success-wrap">
                <div class="match-head-badge">
                    <span class="match-icon">✓</span>
                    <div>
                        <div class="match-title">BİYOMETRİK DOĞRULAMA BAŞARILI</div>
                        <div class="match-score">Eşleşme Güveni: <b>%@matchConfidence</b> (ISO Standartlarında İdeal)</div>
                    </div>
                </div>

                <!-- Misafir ve Oda Bilgi Kartı -->
                <div class="verified-guest-card">
                    <div class="v-guest-header">
                        <img src="@activeGuestPhoto" alt="@matchedGuest.FullName" class="v-guest-avatar" />
                        <div>
                            <h4>@matchedGuest.FullName</h4>
                            <span class="badge b-ok">TC / Pasaport: @matchedGuest.DocNo</span>
                            <div class="muted" style="font-size:0.8rem;margin-top:2px">📍 Uyruk: @matchedGuest.Nationality · GSM: @matchedGuest.Phone</div>
                        </div>
                    </div>

                    <div class="assigned-room-box">
                        <div class="assigned-tag">TAHSİS EDİLEN ODA</div>
                        <div class="room-number-display">
                            <span>Oda @matchedGuest.RoomNumber</span>
                            <small>@matchedGuest.RoomType</small>
                        </div>
                        <div class="room-perks-row">
                            <span>🌊 @matchedGuest.RoomFloor</span>
                            <span>❄️ Klima Eko Açık</span>
                            <span>📶 Wi-Fi: OtelPro_Guest</span>
                        </div>
                    </div>
                </div>

                <!-- Dijital Oda Anahtarı ve QR Kodu -->
                <div class="digital-key-kiosk-box">
                    <div class="key-header">
                        <span class="key-ico">🔑</span>
                        <div>
                            <b>Akıllı Dijital Oda Anahtarı Üretildi</b>
                            <small class="muted" style="display:block">Oda kapısına telefonunuzu yaklaştırarak açabilirsiniz.</small>
                        </div>
                    </div>
                    <div class="key-qr-row">
                        <div class="qr-mock-box">
                            <span class="qr-code-icon">📱</span>
                            <span class="qr-code-text">NFC / BLE AKTİF</span>
                        </div>
                        <div class="key-instruction">
                            <div class="inst-item">✔ <b>EGM Polise Bildirildi:</b> Onay Barkodu #EGM-AKBS-@(new Random().Next(100000, 999999))</div>
                            <div class="inst-item">✔ <b>SMS İletildi:</b> Kapı açma linki @matchedGuest.Phone numarasına yollandı.</div>
                            <div class="inst-item">✔ <b>Oda Kilidi Yetkilendirildi:</b> Kapı hazır.</div>
                        </div>
                    </div>
                </div>

                <div class="match-action-btns">
                    <a class="btn primary" href="/guest-key" target="_blank" style="flex:1;text-align:center">
                        📱 Mobil Dijital Anahtarı Aç
                    </a>
                    <button class="btn" @onclick="ResetScan">
                        🔄 Yeni Misafir Tara
                    </button>
                </div>
            </div>
        }
        else
        {
            <!-- BAŞLANGIÇ / BEKLEME EKRANI -->
            <div class="idle-kiosk-state">
                <div class="idle-icon">📸</div>
                <h3>Kioska Hoş Geldiniz</h3>
                <p class="muted">
                    Lütfen kameraya doğru bakın ve <b>"Yüzü Tara ve Kimliği Doğrula"</b> butonuna basın.
                    Sistem 1 saniye içinde rezervasyonunuzu bularak odanızı tahsis edecek ve dijital anahtarınızı oluşturacaktır.
                </p>
                <div class="kiosk-features-list">
                    <div class="feat-item">🛡️ <b>KVKK & GDPR Uyumlu:</b> Biyometrik veriler anlık işlenir ve saklanmaz.</div>
                    <div class="feat-item">🚨 <b>Canlılık Tespiti (Liveness):</b> Fotoğraf veya ekrandan sahtecilik girişimi engellenir.</div>
                    <div class="feat-item">🪪 <b>EGM AKBS:</b> Resmi polis bildirimi saniyeler içinde tamamlanır.</div>
                </div>
            </div>
        }
    </div>
</div>
</div>

@code {
    bool isScanning = false;
    int scanStep = 0;
    string scanStepMessage = "";
    int selectedGuestPreset = 1;
    string activeGuestPhoto = "/hero.jpg";
    double matchConfidence = 98.9;

    VerifiedGuestModel? matchedGuest;

    protected override void OnInitialized()
    {
        SelectPreset(1);
    }

    void SelectPreset(int presetId)
    {
        selectedGuestPreset = presetId;
        matchedGuest = null;

        activeGuestPhoto = presetId switch
        {
            1 => "/images/room_seaview.jpg",
            2 => "/images/room_deluxe.jpg",
            3 => "/images/room_suite.jpg",
            _ => "/images/room_standard.jpg"
        };
    }

    async Task StartFaceScan()
    {
        isScanning = true;
        matchedGuest = null;
        scanStep = 1;
        scanStepMessage = "Yüz tespit ediliyor ve hizalanıyor...";
        StateHasChanged();
        await Task.Delay(500);

        scanStep = 2;
        scanStepMessage = "128-boyutlu biyometrik öznitelik vektörü çıkarılıyor...";
        StateHasChanged();
        await Task.Delay(500);

        scanStep = 3;
        scanStepMessage = "Otel veritabanı ile kosinüs benzerliği eşleştiriliyor...";
        StateHasChanged();
        await Task.Delay(500);

        scanStep = 4;
        scanStepMessage = "Kimlik doğrulandı! EGM KBS ve Akıllı Kilit tetikleniyor...";
        StateHasChanged();
        await Task.Delay(400);

        isScanning = false;

        matchedGuest = selectedGuestPreset switch
        {
            1 => new VerifiedGuestModel
            {
                FullName = "Dr. Selin Korkmaz",
                DocNo = "28491028472",
                Nationality = "TR",
                Phone = "+90 532 411 22 33",
                RoomNumber = "204",
                RoomType = "Panoramik Deniz Manzaralı Oda",
                RoomFloor = "2. Kat (Deniz Kanadı)"
            },
            2 => new VerifiedGuestModel
            {
                FullName = "James Wilson",
                DocNo = "P98412034",
                Nationality = "UK",
                Phone = "+44 7911 123456",
                RoomNumber = "302",
                RoomType = "Geniş Balkonlu Deluxe Oda",
                RoomFloor = "3. Kat (Doğu Kanadı)"
            },
            3 => new VerifiedGuestModel
            {
                FullName = "Hans Schneider",
                DocNo = "C3849104",
                Nationality = "DE",
                Phone = "+49 151 2345678",
                RoomNumber = "401",
                RoomType = "VIP Kral Dairesi & Jakuzili Penthouse",
                RoomFloor = "4. Kat (Penthouse)"
            },
            _ => new VerifiedGuestModel
            {
                FullName = "Mehmet Karaca",
                DocNo = "10482910394",
                Nationality = "TR",
                Phone = "+90 544 555 66 77",
                RoomNumber = "105",
                RoomType = "Konforlu Standart Oda",
                RoomFloor = "1. Kat (Bahçe Kanadı)"
            }
        };

        matchConfidence = Math.Round(98.2 + new Random().NextDouble() * 1.5, 1);

        // Türkçe kadın asistan sesiyle karşılama mesajı
        string speech = $"Hoş geldiniz Sayın {matchedGuest.FullName}. Biyometrik kimlik doğrulamanız başarıyla tamamlandı. {matchedGuest.RoomNumber} numaralı odanız hazır, iyi tatiller dileriz!";
        _ = JS.InvokeVoidAsync("OtelVoice.speakText", speech, "tr-TR");
    }

    void ResetScan()
    {
        matchedGuest = null;
        isScanning = false;
    }

    void SwitchCamera()
    {
        // Simülasyon kamera açısı değiştirme
        SelectPreset(selectedGuestPreset == 4 ? 1 : selectedGuestPreset + 1);
    }

    public class VerifiedGuestModel
    {
        public string FullName { get; set; } = "";
        public string DocNo { get; set; } = "";
        public string Nationality { get; set; } = "TR";
        public string Phone { get; set; } = "";
        public string RoomNumber { get; set; } = "";
        public string RoomType { get; set; } = "";
        public string RoomFloor { get; set; } = "";
    }
}

<style>
.camera-kiosk-card {
    background: #0f172a;
    border: 1px solid #334155;
    border-radius: 20px;
    padding: 20px;
}
.camera-screen-wrap {
    height: 380px;
    background: #020617;
    border-radius: 16px;
    position: relative;
    overflow: hidden;
    border: 2px solid #334155;
}
.camera-screen-wrap.scanning {
    border-color: #06b6d4;
    box-shadow: 0 0 30px rgba(6, 182, 212, 0.4);
}
.kiosk-cam-feed {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.9) contrast(1.1);
}

/* Siber HUD Katmanı */
.face-hud-overlay {
    position: absolute;
    inset: 40px 60px;
    border: 1px dashed rgba(6, 182, 212, 0.6);
    pointer-events: none;
}
.hud-corner {
    position: absolute;
    width: 24px;
    height: 24px;
    border-color: #06b6d4;
    border-style: solid;
}
.hud-corner.top-left { top: -2px; left: -2px; border-width: 4px 0 0 4px; }
.hud-corner.top-right { top: -2px; right: -2px; border-width: 4px 4px 0 0; }
.hud-corner.bottom-left { bottom: -2px; left: -2px; border-width: 0 0 4px 4px; }
.hud-corner.bottom-right { bottom: -2px; right: -2px; border-width: 0 4px 4px 0; }

.laser-scanner-line {
    position: absolute;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, transparent, #06b6d4, #22d3ee, transparent);
    box-shadow: 0 0 15px #06b6d4;
    animation: scanSweep 1.6s ease-in-out infinite alternate;
}
@@keyframes scanSweep {
    0% { top: 5%; }
    100% { top: 95%; }
}

.landmark-dot {
    position: absolute;
    width: 6px;
    height: 6px;
    background: #22d3ee;
    border-radius: 50%;
    box-shadow: 0 0 8px #22d3ee;
}
.landmark-dot.eye-left { top: 38%; left: 36%; }
.landmark-dot.eye-right { top: 38%; right: 36%; }
.landmark-dot.nose { top: 52%; left: 49%; }
.landmark-dot.mouth { top: 68%; left: 45%; width: 26px; height: 3px; border-radius: 2px; }

.hud-telemetry-text {
    position: absolute;
    bottom: -30px;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    font-size: 0.65rem;
    color: #06b6d4;
    letter-spacing: 1px;
    font-family: monospace;
}

.cam-status-pill {
    position: absolute;
    top: 14px;
    left: 14px;
    background: rgba(15, 23, 42, 0.85);
    border: 1px solid rgba(6, 182, 212, 0.4);
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    color: #e2e8f0;
    display: flex;
    align-items: center;
    gap: 6px;
    backdrop-filter: blur(8px);
}
.live-blink-dot {
    width: 8px;
    height: 8px;
    background: #ef4444;
    border-radius: 50%;
    animation: blink 1s infinite;
}
@@keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }

.kiosk-controls-strip {
    display: flex;
    gap: 12px;
    margin-top: 16px;
}
.btn-scan-trigger {
    flex: 1;
    background: linear-gradient(135deg, #06b6d4, #0ea5e9);
    border: none;
    color: #04121e;
    font-weight: 800;
    font-size: 0.95rem;
    padding: 12px 20px;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.2s;
}
.btn-scan-trigger:hover:not(.disabled) {
    box-shadow: 0 6px 20px rgba(6, 182, 212, 0.4);
    transform: translateY(-2px);
}
.btn-secondary-kiosk {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #cbd5e1;
    padding: 12px 18px;
    border-radius: 12px;
    font-weight: 600;
    cursor: pointer;
}

.presets-section {
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px solid #1e293b;
}
.presets-title {
    display: block;
    font-size: 0.8rem;
    color: #94a3b8;
    margin-bottom: 8px;
}
.presets-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
}
.preset-pill {
    background: #1e293b;
    border: 1px solid #334155;
    color: #cbd5e1;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 0.8rem;
    cursor: pointer;
    text-align: left;
    transition: all 0.2s;
}
.preset-pill:hover, .preset-pill.active {
    background: hsla(189, 94%, 43%, 0.15);
    border-color: #06b6d4;
    color: #06b6d4;
}

/* Sağ Panel */
.result-card {
    background: #0f172a;
    border: 1px solid #334155;
    border-radius: 20px;
    padding: 24px;
    display: flex;
    flex-direction: column;
}
.scanning-loader-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    text-align: center;
    padding: 40px 20px;
}
.cyber-spinner {
    width: 60px;
    height: 60px;
    border: 4px solid rgba(6, 182, 212, 0.2);
    border-top-color: #06b6d4;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin-bottom: 20px;
}
@@keyframes spin { to { transform: rotate(360deg); } }
.scan-progress-bar {
    width: 100%;
    height: 8px;
    background: #1e293b;
    border-radius: 999px;
    overflow: hidden;
    margin: 16px 0 8px;
}
.scan-fill {
    height: 100%;
    background: linear-gradient(90deg, #06b6d4, #10b981);
    transition: width 0.4s ease;
}
.scan-step-note {
    font-size: 0.82rem;
    color: #06b6d4;
    font-weight: 600;
}

.match-success-wrap {
    display: flex;
    flex-direction: column;
    gap: 16px;
}
.match-head-badge {
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.2), rgba(6, 182, 212, 0.15));
    border: 1px solid #10b981;
    border-radius: 14px;
    padding: 12px 16px;
    display: flex;
    align-items: center;
    gap: 12px;
}
.match-icon {
    width: 38px;
    height: 38px;
    background: #10b981;
    color: #04121e;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 1.3rem;
    font-weight: 900;
}
.match-title {
    font-size: 0.95rem;
    font-weight: 800;
    color: #34d399;
}
.match-score {
    font-size: 0.8rem;
    color: #cbd5e1;
}

.verified-guest-card {
    background: #1e293b;
    border-radius: 14px;
    padding: 16px;
}
.v-guest-header {
    display: flex;
    gap: 14px;
    align-items: center;
    margin-bottom: 14px;
}
.v-guest-avatar {
    width: 54px;
    height: 54px;
    border-radius: 12px;
    object-fit: cover;
    border: 2px solid #06b6d4;
}
.v-guest-header h4 {
    margin: 0 0 4px;
    font-size: 1.15rem;
    color: #fff;
}
.assigned-room-box {
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid rgba(56, 189, 248, 0.3);
    border-radius: 12px;
    padding: 12px 16px;
}
.assigned-tag {
    font-size: 0.7rem;
    font-weight: 800;
    color: #38bdf8;
    letter-spacing: 1px;
}
.room-number-display {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin: 4px 0 6px;
}
.room-number-display span {
    font-size: 1.4rem;
    font-weight: 800;
    color: #2dd4bf;
}
.room-number-display small {
    color: #cbd5e1;
    font-size: 0.85rem;
}
.room-perks-row {
    display: flex;
    gap: 12px;
    font-size: 0.75rem;
    color: #94a3b8;
}

.digital-key-kiosk-box {
    background: hsla(217, 33%, 16%, 0.8);
    border: 1px dashed rgba(45, 212, 191, 0.4);
    border-radius: 14px;
    padding: 14px;
}
.key-header {
    display: flex;
    gap: 10px;
    align-items: center;
