@page "/guest-key"
@layout Otel.Web.Components.Layout.PublicLayout
@inject AppDb Db
@inject HotelState CurrentHotelState
@inject IJSRuntime JS

<div class="guest-key-portal">
    <div class="portal-header-tag">
        <span>📱 5 YILDIZLI TEMASSIZ MİSAFİR KOKPİTİ</span>
        <h2>Dijital Mobil Oda Anahtarı & Misafir Konsolu</h2>
        <p class="muted">
            Resepsiyon sırası beklemeden cep telefonunuzla oda kapınızı açın, oda servisi isteyin ve Wi-Fi'a tek tıkla bağlanın.
        </p>
    </div>

    <!-- Hızlı Rezervasyon / Misafir Değiştirici (Jüri Demosu İçin) -->
    <div class="guest-picker-bar">
        <span class="label">👤 Aktif Misafir / Oda Seçimi:</span>
        <button class="g-pill @(selectedGuestId == 1 ? "active" : "")" @onclick="() => SwitchGuest(1)">
            👩‍⚕️ Dr. Selin Korkmaz (Oda 204)
        </button>
        <button class="g-pill @(selectedGuestId == 2 ? "active" : "")" @onclick="() => SwitchGuest(2)">
            👨‍💼 James Wilson (Oda 302)
        </button>
        <button class="g-pill @(selectedGuestId == 3 ? "active" : "")" @onclick="() => SwitchGuest(3)">
            🇩🇪 Hans Schneider (Oda 401 VIP)
        </button>
    </div>

    <!-- MOBİL TELEFON GÖRÜNÜMÜ KOKPİTİ (SMARTPHONE MOCKUP) -->
    <div class="mobile-phone-frame">
        <div class="phone-speaker-notch"></div>

        <!-- Telefon Ekranı -->
        <div class="phone-screen-inner">
            <!-- Üst Durum Çubuğu -->
            <div class="phone-status-bar">
                <span>09:41</span>
                <span>📶 5G · %98 🔋</span>
            </div>

            <!-- Tesis ve Misafir Başlığı -->
            <div class="phone-hotel-header">
                <div class="hotel-logo-circle">🏨</div>
                <div>
                    <h4>@(CurrentHotelState.SelectedHotel?.Name ?? "Grand Aegean Resort & Spa")</h4>
                    <span class="room-pill-chip">Oda @currentRoomNum · @currentRoomType</span>
                </div>
            </div>

            <div class="phone-scroll-body">
                <!-- DOKUNMATİK AKILLI DİJİTAL ODA ANAHTARI (NFC / BLE) -->
                <div class="smart-key-card @(isUnlocking ? "unlocking" : "") @(isUnlocked ? "unlocked" : "")">
                    <div class="key-top-status">
                        <span class="pulse-indicator"></span>
                        <span>@(isUnlocked ? "KAPI AÇIK — HOŞ GELDİNİZ" : (isUnlocking ? "KİLİT AÇILIYOR..." : "KAPININ YANINDASINIZ"))</span>
                    </div>

                    <button class="digital-key-orb" @onclick="UnlockDoor" disabled="@isUnlocking">
                        <div class="orb-ring-wave"></div>
                        <div class="orb-ring-pulse"></div>
                        <div class="orb-core">
                            <span class="orb-icon">@(isUnlocked ? "🔓" : "🔑")</span>
                            <span class="orb-label">@(isUnlocked ? "AÇILDI" : "KAPIYI AÇ")</span>
                        </div>
                    </button>

                    <div class="key-bottom-instruction">
                        @if (isUnlocked)
                        {
                            <span style="color:#34d399;font-weight:700">✓ Kilit Açıldı! Kapıyı iterek girebilirsiniz.</span>
                        }
                        else
                        {
                            <span class="muted">Oda kapısına 1 metre mesafede butona dokunun</span>
                        }
                    </div>
                </div>

                <!-- HIZLI ODA SERVİSİ VE KONFOR KONTROLLERİ -->
                <div class="phone-controls-section">
                    <h5>✨ Akıllı Oda Denetimi</h5>
                    <div class="room-action-grid">
                        <button class="action-tile @(isDndActive ? "active-dnd" : "")" @onclick="ToggleDnd">
                            <span class="tile-ico">🛑</span>
                            <span class="tile-title">Rahatsız Etmeyin</span>
                            <span class="tile-sub">@(isDndActive ? "AÇIK (DND)" : "KAPALI")</span>
                        </button>
                        <button class="action-tile @(isCleanRequested ? "active-clean" : "")" @onclick="RequestCleaning">
                            <span class="tile-ico">🧹</span>
                            <span class="tile-title">Odamı Temizleyin</span>
                            <span class="tile-sub">@(isCleanRequested ? "İletildi ✓" : "Talep Gönder")</span>
                        </button>
                        <button class="action-tile" @onclick="CopyWifi">
                            <span class="tile-ico">📶</span>
                            <span class="tile-title">Wi-Fi Şifresi</span>
                            <span class="tile-sub">@(wifiCopied ? "Kopyalandı! ✓" : "OtelPro_VIP")</span>
                        </button>
                        <button class="action-tile" @onclick="() => showRoomServiceModal = true">
                            <span class="tile-ico">🥐</span>
                            <span class="tile-title">Oda Servisi</span>
                            <span class="tile-sub">Yiyecek & İçecek</span>
                        </button>
                    </div>
                </div>

                <!-- DİJİTAL FOLIO VE HIZLI CHECK-OUT -->
                <div class="phone-checkout-card">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
                        <span style="font-size:0.8rem;color:#94a3b8">Oda Hesabı (Folio):</span>
                        <b style="color:#2dd4bf;font-size:1.1rem">@Fmt.Money(currentFolioTotal)</b>
                    </div>
                    <button class="btn-mobile-checkout" @onclick="DoMobileCheckout">
                        ⚡ 1-Tıkla Temassız Hızlı Check-out
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ODA SERVİSİ HIZLI SİPARİŞ MODALI -->
@if (showRoomServiceModal)
{
    <div class="modal-backdrop" @onclick="() => showRoomServiceModal = false">
        <div class="service-modal" @onclick:stopPropagation>
            <div class="modal-head">
                <h3>🍽️ Oda Servisi & İkram Siparişi (Oda @currentRoomNum)</h3>
                <button class="x" @onclick="() => showRoomServiceModal = false">✕</button>
            </div>
            <div class="modal-body">
                <p class="muted" style="font-size:0.85rem">Siparişleriniz 15-20 dakika içinde taze olarak odanıza servis edilecek ve oda hesabınıza yansıtılacaktır.</p>

                <div class="menu-items-list">
                    <div class="menu-item-row">
                        <div>
                            <b>🥐 Paris Usulü Kruvasan & Taze Espresso</b>
                            <small class="muted" style="display:block">Tereyağlı çıtır kruvasan ve çift shot espresso</small>
                        </div>
                        <div style="display:flex;align-items:center;gap:10px">
                            <span class="m-price">180 ₺</span>
                            <button class="btn sm primary" @onclick='() => OrderItem("Kruvasan & Espresso", 180)'>＋ Ekle</button>
                        </div>
                    </div>
                    <div class="menu-item-row">
                        <div>
                            <b>🍷 Ege Şarap & Gurme Peynir Tabağı</b>
                            <small class="muted" style="display:block">Ezine, tulum, kurutulmuş meyve ve ceviz ile</small>
                        </div>
                        <div style="display:flex;align-items:center;gap:10px">
                            <span class="m-price">750 ₺</span>
                            <button class="btn sm primary" @onclick='() => OrderItem("Şarap & Peynir Tabağı", 750)'>＋ Ekle</button>
                        </div>
                    </div>
                    <div class="menu-item-row">
                        <div>
                            <b>💧 Ekstra Banyo Havlusu & Yastık</b>
                            <small class="muted" style="display:block">Anti-alerjik kaz tüyü yastık ve büyük banyo havlusu</small>
                        </div>
                        <div style="display:flex;align-items:center;gap:10px">
                            <span class="m-price" style="color:#34d399">Ücretsiz</span>
                            <button class="btn sm" @onclick='() => OrderItem("Ekstra Havlu/Yastık", 0)'>＋ Talep Et</button>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(serviceAlert))
                {
                    <div class="alert ok" style="margin-top:14px">@serviceAlert</div>
                }
            </div>
        </div>
    </div>
}

@code {
    int selectedGuestId = 1;
    string currentRoomNum = "204";
    string currentRoomType = "Panoramik Deniz Manzaralı";
    decimal currentFolioTotal = 450;

    bool isUnlocking = false;
    bool isUnlocked = false;

    bool isDndActive = false;
    bool isCleanRequested = false;
    bool wifiCopied = false;

    bool showRoomServiceModal = false;
    string? serviceAlert;

    void SwitchGuest(int guestId)
    {
        selectedGuestId = guestId;
        isUnlocked = false;
        isDndActive = false;
        isCleanRequested = false;

        if (guestId == 1)
        {
            currentRoomNum = "204";
            currentRoomType = "Panoramik Deniz Manzaralı";
            currentFolioTotal = 450;
        }
        else if (guestId == 2)
        {
            currentRoomNum = "302";
            currentRoomType = "Geniş Balkonlu Deluxe Oda";
            currentFolioTotal = 820;
        }
        else
        {
            currentRoomNum = "401";
            currentRoomType = "VIP Kral Dairesi Penthouse";
            currentFolioTotal = 2400;
        }
    }

    async Task UnlockDoor()
    {
        if (isUnlocking) return;

        isUnlocking = true;
        isUnlocked = false;
        StateHasChanged();

        // 1.2 saniyelik Bluetooth & NFC kilit el sıkışma simülasyonu
        await Task.Delay(1200);

        isUnlocking = false;
        isUnlocked = true;
        StateHasChanged();

        // Türkçe kadın asistan sesiyle sesli bildirim
        _ = JS.InvokeVoidAsync("OtelVoice.speakText", $"Oda {currentRoomNum} kapısının kilidi açıldı. Hoş geldiniz!", "tr-TR");

        // 6 saniye sonra kilit güvenliği için tekrar kilitli duruma geç
        _ = Task.Run(async () =>
        {
            await Task.Delay(6000);
            isUnlocked = false;
            await InvokeAsync(StateHasChanged);
        });
    }

    void ToggleDnd()
    {
        isDndActive = !isDndActive;
        if (isDndActive) isCleanRequested = false;
    }

    void RequestCleaning()
    {
        isCleanRequested = true;
        isDndActive = false;
    }

    async Task CopyWifi()
    {
        wifiCopied = true;
        await Task.Delay(2500);
        wifiCopied = false;
    }

    void OrderItem(string item, decimal price)
    {
        currentFolioTotal += price;
        serviceAlert = $"✅ '{item}' siparişiniz alındı! Odanıza servis ediliyor. (+{Fmt.Money(price)})";
    }

    void DoMobileCheckout()
    {
        _ = JS.InvokeVoidAsync("OtelVoice.speakText", $"Oda {currentRoomNum} için hızlı check out işleminiz tamamlandı. Bizi tercih ettiğiniz için teşekkür ederiz!", "tr-TR");
        currentFolioTotal = 0;
    }
}

