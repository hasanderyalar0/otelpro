    async Task SetBoardFilter(string? code)
    {
        selectedBoardCode = code;
        if (code != null)
        {
            var targetBoard = boardTypes.FirstOrDefault(b => b.Code == code);
            if (targetBoard != null) boardTypeId = targetBoard.Id;
