@code {
    DateTime checkIn = DateTime.Today.AddDays(1);
    DateTime checkOut = DateTime.Today.AddDays(3);
    int adults = 2;
    int children = 0;

    List<RoomType> roomTypes = new();
    List<BoardType> boardTypes = new();
    Dictionary<int, int> availableMap = new();
    Dictionary<int, PriceQuote> quoteMap = new();

    List<Hotel> hotels = new();
    int selectedHotelId;
    Hotel? currentHotel;

    // Filtreleme Değişkenleri
    string regionFilter = "all"; // "all", "tr", "global"
    string? selectedBoardCode = null; // null = Otel Orijinal Konsepti
    string? featureFilter = null; // "sea", "jacuzzi", "family", "balcony"
    string sortOption = "price_asc";

    // Rezervasyon Modalı
    RoomType? selectedRt;
    PriceQuote? selectedQuote;
    int boardTypeId;
    bool showBookingModal;
    bool isSubmitting;
    string? modalError;

    string guestFirstName = "";
    string guestLastName = "";
    string guestEmail = "";
    string guestPhone = "";
    string guestDocNo = "";
    string bookingNotes = "";

    Reservation? bookedReservation;

    // Fotoğraf Lightbox Modalı
    bool showPhotoModal = false;
    RoomType? photoModalRt;

    [SupplyParameterFromQuery(Name = "hotelId")]
    public int? HotelId { get; set; }

    List<Hotel> displayedHotels
    {
        get
        {
            if (regionFilter == "tr") return hotels.Where(IsDomesticHotel).ToList();
            if (regionFilter == "global") return hotels.Where(h => !IsDomesticHotel(h)).ToList();
            return hotels;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        hotels = await Db.Hotels.ToListAsync();
        boardTypes = await Db.BoardTypes.ToListAsync();

        if (HotelId.HasValue && hotels.Any(h => h.Id == HotelId.Value))
        {
            selectedHotelId = HotelId.Value;
            currentHotel = hotels.First(h => h.Id == HotelId.Value);
        }
        else if (CurrentHotelState.SelectedHotelId > 0 && hotels.Any(h => h.Id == CurrentHotelState.SelectedHotelId))
        {
            selectedHotelId = CurrentHotelState.SelectedHotelId;
            currentHotel = hotels.First(h => h.Id == CurrentHotelState.SelectedHotelId);
        }
        else if (hotels.Count > 0)
        {
            selectedHotelId = hotels[0].Id;
            currentHotel = hotels[0];
        }

        // Tesisin varsayılan pansiyon tipini belirle
        SyncDefaultBoardType();

        await SearchRooms();
    }

    void SyncDefaultBoardType()
    {
        if (selectedBoardCode == null)
        {
            var defCode = GetHotelDefaultBoardCode(currentHotel);
            var bObj = boardTypes.FirstOrDefault(b => b.Code == defCode) ?? boardTypes.FirstOrDefault();
            if (bObj != null) boardTypeId = bObj.Id;
        }
    }

