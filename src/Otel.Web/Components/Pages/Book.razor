    async Task SelectRoomType(RoomType rt)
    {
        selectedRt = rt;
        modalError = null;

        if (rt.Hotel != null)
        {
            currentHotel = rt.Hotel;
            selectedHotelId = rt.HotelId;
        }
        else if (hotels.Any(h => h.Id == rt.HotelId))
        {
            currentHotel = hotels.First(h => h.Id == rt.HotelId);
            selectedHotelId = rt.HotelId;
        }

        if (selectedBoardCode == null)
        {
            var defCode = GetHotelDefaultBoardCode(currentHotel);
            var bObj = boardTypes.FirstOrDefault(b => b.Code == defCode);
            if (bObj != null) boardTypeId = bObj.Id;
        }

        await RecalculateSelected();
        showBookingModal = true;
    }

    async Task RecalculateSelected()
    {
        if (selectedRt != null)
        {
            selectedQuote = await Booking.QuoteAsync(selectedRt.Id, checkIn, checkOut, adults, children, boardTypeId, null);
        }
    }

    async Task CompleteGuestBooking()
    {
        if (string.IsNullOrWhiteSpace(guestFirstName) || string.IsNullOrWhiteSpace(guestLastName))
        {
            modalError = "Lütfen adınızı ve soyadınızı girin.";
            return;
        }
        if (string.IsNullOrWhiteSpace(guestPhone))
        {
            modalError = "Lütfen telefon numaranızı girin.";
            return;
        }

        isSubmitting = true;
        modalError = null;

        try
        {
            var guest = await Db.Guests.FirstOrDefaultAsync(g => g.Email == guestEmail && !string.IsNullOrEmpty(guestEmail));
            if (guest == null)
            {
                guest = new Guest
                {
                    FirstName = guestFirstName.Trim(),
                    LastName = guestLastName.Trim(),
                    Email = guestEmail.Trim(),
                    Phone = guestPhone.Trim(),
                    Nationality = "TR"
                };
                if (!string.IsNullOrEmpty(guestDocNo))
                {
                    guest.Documents.Add(new GuestDocument { DocType = "TC", DocNumber = guestDocNo.Trim() });
                }
                Db.Guests.Add(guest);
                await Db.SaveChangesAsync();
            }

            var webChannel = await Db.Channels.FirstOrDefaultAsync(c => c.Code == "WEB");

            var req = new BookingRequest
            {
                GuestId = guest.Id,
                RoomTypeId = selectedRt!.Id,
                BoardTypeId = boardTypeId,
                ChannelId = webChannel?.Id,
                CheckIn = checkIn,
                CheckOut = checkOut,
                Adults = adults,
                Children = children,
                Notes = bookingNotes,
                Status = ResStatus.Confirmed
            };

            bookedReservation = await Booking.CreateAsync(req);
            showBookingModal = false;
        }
        catch (Exception ex)
        {
            modalError = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    void ResetForm()
    {
        bookedReservation = null;
        SearchRooms();
    }
