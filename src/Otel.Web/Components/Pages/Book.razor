@page "/book"
@layout Otel.Web.Components.Layout.PublicLayout
@inject AppDb Db
@inject BookingService Booking

<div class="booking-portal">
    <!-- Üst Başlık ve Tesis Bilgisi -->
    <div class="booking-header">
        <span class="booking-tag">🛎️ Komisyonsuz Doğrudan Otel Rezervasyonu</span>
        <h1>@(selectedHotelId == 0 ? "Global & Türkiye Otellerimiz (16 Tesis)" : (currentHotel?.Name ?? "Lüks Otel Rezervasyonu"))</h1>
        <p class="hotel-sub">
            @if (selectedHotelId == 0)
            {
                <span>🌍 Bodrum'dan İsviçre Alplerine, Manhattan'dan Tokyo'ya 16 Farklı 5 Yıldızlı Lüks Tesis · En İyi Fiyat Garantisi</span>
            }
            else
            {
                <span>📍 @(currentHotel?.City ?? "Türkiye") · ⭐ 5 Yıldızlı Lüks Deneyim · En İyi Fiyat Garantisi & Doğrudan İptal Güvencesi</span>
            }
        </p>
    </div>

    <!-- 16 OTELİN TAMAMINI GÖSTEREN VİTRİN & DESTİNASYON KEŞİF PANELİ -->
    <div class="hotels-explorer-card">
        <div class="explorer-top-row">
            <div class="explorer-title-box">
                <span class="icon">🏨</span>
                <div>
                    <h3>Tüm Otellerimizi Keşfedin (16 Tesis)</h3>
                    <small class="muted">Aşağıdan dilediğiniz oteli seçerek odalarını inceleyebilir veya tüm tesislerin müsait odalarını birlikte karşılaştırabilirsiniz.</small>
                </div>
            </div>

            <!-- Bölge Filtreleme Butonları -->
            <div class="region-filter-tabs">
                <button class="region-tab @(regionFilter == "all" ? "active" : "")" @onclick='() => SetRegionFilter("all")'>
                    🌟 Tümü (16 Otel)
                </button>
                <button class="region-tab @(regionFilter == "tr" ? "active" : "")" @onclick='() => SetRegionFilter("tr")'>
                    🇹🇷 Türkiye (8 Tesis)
                </button>
                <button class="region-tab @(regionFilter == "global" ? "active" : "")" @onclick='() => SetRegionFilter("global")'>
                    ✈️ Yurt Dışı (8 Tesis)
                </button>
                <button class="region-tab list-all-btn @(selectedHotelId == 0 ? "active" : "")" @onclick="() => SwitchHotel(0)">
                    🌐 Tüm Odaları Birlikte Listele
                </button>
            </div>
        </div>

        <!-- 16 Otel Kartları Izgarası -->
        <div class="hotels-showcase-grid">
            @foreach (var h in displayedHotels)
            {
                var isSelected = selectedHotelId == h.Id;
                var flag = GetHotelFlag(h);
                var img = GetHotelImage(h);
                var highlight = GetHotelHighlight(h);
                var startPrice = GetHotelStartingPrice(h);
                var conceptText = GetHotelDefaultConceptText(h);

                <div class="hotel-showcase-card @(isSelected ? "selected" : "")" @onclick="() => SwitchHotel(h.Id)">
                    <div class="hotel-card-media">
                        <img src="@img" alt="@h.Name" loading="lazy" />
                        <span class="hotel-flag-badge">@flag @h.City</span>
                        <span class="hotel-concept-badge">@conceptText</span>
                        @if (isSelected)
                        {
                            <div class="selected-overlay-badge">
                                <span>✓ SEÇİLİ TESİS</span>
                            </div>
                        }
                    </div>
                    <div class="hotel-card-body">
                        <div class="hotel-card-name-row">
                            <h4 title="@h.Name">@h.Name</h4>
                            <span class="stars-badge">⭐⭐⭐⭐⭐</span>
                        </div>
                        <p class="hotel-highlight-tag">📍 @highlight</p>
                        <div class="hotel-card-footer">
                            <div class="hotel-price-tag">
                                <small>Gecelik</small>
                                <b>@Fmt.Money(startPrice)</b><small>'den</small>
                            </div>
                            <button class="btn-select-hotel @(isSelected ? "active" : "")">
                                @(isSelected ? "Odaları Gösteriliyor" : "Bu Oteli Seç ➜")
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Tarih, Kişi ve Otel Hızlı Arama Çubuğu -->
    <div class="search-bar-card">
        <div class="search-inputs-grid">
            <div class="input-block hotel-selector-block">
                <label>🏨 Seçili Otel / Destinasyon</label>
                <select @bind="selectedHotelId" @bind:after="OnHotelDropdownChanged">
                    <option value="0">🌟 Tüm Oteller (16 Tesis - Birlikte Karşılaştır)</option>
                    <optgroup label="🇹🇷 Türkiye Otelleri (8 Tesis)">
                        @foreach (var h in hotels.Where(IsDomesticHotel))
                        {
                            <option value="@h.Id">🇹🇷 @h.Name (@h.City)</option>
                        }
                    </optgroup>
                    <optgroup label="🌍 Global & Yurt Dışı Otelleri (8 Tesis)">
                        @foreach (var h in hotels.Where(h => !IsDomesticHotel(h)))
                        {
                            <option value="@h.Id">@GetHotelFlag(h) @h.Name (@h.City)</option>
                        }
                    </optgroup>
                </select>
            </div>
            <div class="input-block">
                <label>📅 Giriş Tarihi</label>
                <input type="date" @bind="checkIn" @bind:after="SearchRooms" />
            </div>
            <div class="input-block">
                <label>📅 Çıkış Tarihi</label>
                <input type="date" @bind="checkOut" @bind:after="SearchRooms" />
            </div>
            <div class="input-block">
                <label>👥 Yetişkin</label>
                <input type="number" min="1" max="6" @bind="adults" @bind:after="SearchRooms" />
            </div>
            <div class="input-block">
                <label>🧒 Çocuk</label>
                <input type="number" min="0" max="4" @bind="children" @bind:after="SearchRooms" />
            </div>
            <div class="input-block btn-block">
                <button class="btn-search-trigger" @onclick="SearchRooms">
                    🔍 Müsaitlik Ara
                </button>
            </div>
        </div>
    </div>

    <!-- Gelişmiş Filtreleme Barı (Pansiyon / Yemek Tipi ve Oda Özellikleri) -->
    <div class="filter-strip-card">
        <div class="filter-section-title">
            <span class="icon">✨</span>
            <span><b>Konaklama & Yemek Konsepti Tercihi:</b></span>
            <small class="muted" style="margin-left:8px;font-size:0.82rem">Her otelin kendi orijinal konsepti farklıdır (Ultra Her Şey Dahil, Yarım Pansiyon, Gurme Kahvaltı vb.)</small>
        </div>
        
        <!-- Pansiyon / Yemek Seçenekleri -->
        <div class="filter-pills-row">
            <button class="filter-pill @(selectedBoardCode == null ? "active" : "")" @onclick="() => SetBoardFilter(null)">
                🌟 Otel Orijinal Konsepti <span class="pill-badge">Önerilen</span>
            </button>
            <button class="filter-pill @(selectedBoardCode == "RO" ? "active" : "")" @onclick='() => SetBoardFilter("RO")'>
                🛏️ Sadece Oda (Room Only)
            </button>
            <button class="filter-pill @(selectedBoardCode == "BB" ? "active" : "")" @onclick='() => SetBoardFilter("BB")'>
                ☕ Kahvaltı Dahil (Oda + Kahvaltı)
            </button>
            <button class="filter-pill @(selectedBoardCode == "HB" ? "active" : "")" @onclick='() => SetBoardFilter("HB")'>
                🍽️ Yarım Pansiyon (Sabah + Akşam)
            </button>
            <button class="filter-pill @(selectedBoardCode == "FB" ? "active" : "")" @onclick='() => SetBoardFilter("FB")'>
                🍲 Tam Pansiyon (3 Öğün Açık Büfe)
            </button>
            <button class="filter-pill @(selectedBoardCode == "AI" ? "active" : "")" @onclick='() => SetBoardFilter("AI")'>
                🍸 Ultra Her Şey Dahil (Yemek + İçecek)
            </button>
        </div>

        <div class="filter-divider"></div>

        <!-- Oda Tipi / Manzara Özellikleri ve Sıralama -->
        <div class="filter-secondary-row">
            <div class="amenity-filters">
                <span class="sub-label">Özel Filtre:</span>
                <button class="tag-btn @(featureFilter == null ? "active" : "")" @onclick="() => featureFilter = null">
                    Tüm Odalar
                </button>
                <button class="tag-btn @(featureFilter == "sea" ? "active" : "")" @onclick='() => featureFilter = (featureFilter == "sea" ? null : "sea")'>
                    🌊 Deniz Manzaralı
                </button>
                <button class="tag-btn @(featureFilter == "jacuzzi" ? "active" : "")" @onclick='() => featureFilter = (featureFilter == "jacuzzi" ? null : "jacuzzi")'>
                    🛁 Jakuzili / VIP Suit
                </button>
                <button class="tag-btn @(featureFilter == "family" ? "active" : "")" @onclick='() => featureFilter = (featureFilter == "family" ? null : "family")'>
                    👨‍👩‍👧 Geniş Aile Odası
                </button>
                <button class="tag-btn @(featureFilter == "balcony" ? "active" : "")" @onclick='() => featureFilter = (featureFilter == "balcony" ? null : "balcony")'>
                    🏞️ Balkon / Teras
                </button>
            </div>

            <!-- Sıralama -->
            <div class="sort-select-wrap">
                <span class="sub-label">Sırala:</span>
                <select @bind="sortOption">
                    <option value="price_asc">Fiyat: Düşükten Yükseğe</option>
                    <option value="price_desc">Fiyat: Yüksekten Düşüğe</option>
                    <option value="capacity">Kapasiteye Göre</option>
                </select>
            </div>
        </div>
    </div>

    @if (bookedReservation != null)
    {
        <!-- Başarılı Rezervasyon Kutusu -->
        <div class="booking-success-box">
            <div class="celebrate-icon">🎉</div>
            <h2>Rezervasyonunuz Başarıyla Alındı!</h2>
            <p class="res-code-highlight">Rezervasyon Numaranız: <b>@bookedReservation.Code</b></p>
            <p class="muted">
                Tarafınıza SMS ve E-posta teyit bildirimleri iletilmiştir. Otel girişinde kimlik / pasaport ibraz etmeniz yeterlidir.
            </p>
            <button class="btn-primary-large" style="margin-top:20px" @onclick="ResetForm">
                ＋ Başka Bir Rezervasyon Yap
            </button>
        </div>
    }
    else
    {
        <!-- Başlık ve Oda Sayısı Göstergesi -->
        <div class="rooms-results-head">
            <h3>
                <span>Müsait Oda Seçenekleri</span>
                <span class="badge b-ok" style="font-size:0.85rem">@filteredRoomTypes.Count Oda Tipi Listeleniyor</span>
            </h3>
            @if (selectedHotelId == 0)
            {
                <span class="muted" style="font-size:0.88rem">16 Tesisin tamamından oda tipleri karşılaştırılıyor</span>
            }
            else
            {
                <span class="muted" style="font-size:0.88rem">@(currentHotel?.Name) için doğrudan rezervasyon</span>
            }
        </div>

        <!-- Oda Kartları Listesi -->
        <div class="rooms-grid">
            @if (filteredRoomTypes.Count == 0)
            {
                <div class="no-rooms-card">
                    <span class="icon">🔍</span>
                    <h3>Seçtiğiniz filtrelere uygun oda bulunamadı</h3>
                    <p class="muted">Filtreleri sıfırlayarak tesisin diğer müsait odalarını inceleyebilirsiniz.</p>
                    <button class="btn-secondary" @onclick="ResetFilters">Filtreleri Temizle</button>
                </div>
            }

            @foreach (var rt in filteredRoomTypes)
            {
                var availCount = availableMap.GetValueOrDefault(rt.Id, 0);
                var quote = quoteMap.GetValueOrDefault(rt.Id);
                var nights = Math.Max(1, (checkOut - checkIn).Days);
                var imgUrl = GetRoomImage(rt);
                var hForRt = rt.Hotel ?? hotels.FirstOrDefault(x => x.Id == rt.HotelId) ?? currentHotel;
                var mealBadge = GetRoomConceptBadge(hForRt, rt, selectedBoardCode);

                <div class="room-card">
                    <!-- Çoklu Otel Modunda Otel Başlık Şeridi -->
                    @if (selectedHotelId == 0 || (currentHotel != null && rt.HotelId != currentHotel.Id))
                    {
                        var flag = GetHotelFlag(hForRt);
                        <div class="room-hotel-badge">
                            <span class="hotel-flag">@flag</span>
                            <span class="hotel-title"><b>@(hForRt?.Name ?? "Otel")</b></span>
                            <span class="hotel-city">📍 @(hForRt?.City ?? "")</span>
                        </div>
                    }

                    <!-- Fotoğraf Alanı -->
                    <div class="room-media-wrap" @onclick="() => OpenPhotoModal(rt)">
                        <img src="@imgUrl" alt="@rt.Name" class="room-img" loading="lazy" />
                        
                        <!-- Fotoğraf Üzeri Rozetler (Orijinal Konsepte Göre Dinamik) -->
                        <div class="room-photo-badges">
                            <span class="badge-float meal">@mealBadge</span>

                            @if (rt.Name.Contains("Deniz"))
                            {
                                <span class="badge-float sea">🌊 Deniz Manzaralı</span>
                            }
                            else if (rt.Name.Contains("Suit"))
                            {
                                <span class="badge-float jacuzzi">🛁 Özel Jakuzi & VIP</span>
                            }
                        </div>

                        <!-- Fotoğraf Alt Şerit -->
                        <div class="room-photo-meta">
                            <span>👥 @rt.MaxCapacity Kişi</span>
                            <span>📐 @rt.AreaM2 m²</span>
                            <span>🛏️ @rt.BedType</span>
                        </div>
                    </div>

                    <!-- Kart İçeriği -->
                    <div class="room-content">
                        <div class="room-title-row">
                            <h3 class="room-title">@rt.Name</h3>
                            <button class="btn-photo-zoom" title="Fotoğrafı Büyüt" @onclick="() => OpenPhotoModal(rt)">
                                🔍 Fotoğraflar
                            </button>
                        </div>
                        <p class="room-desc">@rt.Description</p>

                        <!-- Oda İçi Donanım & Özellikler (Otele ve Odaya Özel) -->
                        <div class="room-amenities-tags">
                            @foreach (var am in GetRoomAmenityTags(rt, hForRt))
                            {
                                <span class="amenity-chip">@am</span>
                            }
                        </div>

                        <div class="room-perk-note">
                            ✔ Ücretsiz İptal Güvencesi & Girişte Ödeme İmkânı
                        </div>
                    </div>

                    <!-- Fiyat ve Rezervasyon Butonu -->
                    <div class="room-footer">
                        @if (availCount > 0)
                        {
                            <div class="price-block">
                                <div class="price-sub">@nights Gece Toplam Tutar:</div>
                                <div class="price-main">
                                    @Fmt.Money(quote?.Total ?? (rt.BasePrice * nights))
                                </div>
                                <div class="price-nightly">
                                    Gecelik ortalama @Fmt.Money((quote?.Total ?? (rt.BasePrice * nights)) / nights)
                                </div>
                            </div>

                            <div class="action-block">
                                @if (availCount <= 2)
                                {
                                    <span class="avail-tag urgent">🔥 Son @availCount Oda!</span>
                                }
                                else
                                {
                                    <span class="avail-tag ok">🟢 @availCount Oda Müsait</span>
                                }

                                <button class="btn-book-now" @onclick="() => SelectRoomType(rt)">
                                    ⚡ Rezervasyon Yap
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="sold-out-box">
                                <span class="sold-text">Bu tarihlerde kontenjan doldu</span>
                                <small class="muted">Lütfen farklı tarih aralığı deneyin</small>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Rezervasyon Tamamlama Modalı -->
<Modal Show="showBookingModal" ShowChanged="(v) => showBookingModal = v" Title="@(selectedRt != null ? $"{selectedRt.Name} Rezervasyonu" : "Rezervasyon")">
    @if (selectedRt != null)
    {
        var hModal = selectedRt.Hotel ?? hotels.FirstOrDefault(x => x.Id == selectedRt.HotelId) ?? currentHotel;

        <div class="modal-booking-wrap">
            <!-- Seçilen Oda & Otel Özeti -->
            <div class="modal-room-summary">
                <img src="@GetRoomImage(selectedRt)" alt="@selectedRt.Name" class="summary-thumb" />
                <div>
                    <h4 style="margin:0 0 4px">@selectedRt.Name</h4>
                    <div style="font-size:0.85rem;color:#38bdf8;font-weight:600;margin-bottom:4px">
                        🏨 @(hModal?.Name) (@(hModal?.City))
                    </div>
                    <small class="muted">
                        📅 @checkIn.ToString("dd.MM.yyyy") – @checkOut.ToString("dd.MM.yyyy") (@((checkOut - checkIn).Days) Gece) · 👥 @adults Yetişkin @(children > 0 ? $"+ {children} Çocuk" : "")
                    </small>
                </div>
            </div>

            <!-- Form Alanları -->
            <div class="form-grid-modal">
                <div class="f-group">
                    <label>Adınız (*)</label>
                    <input @bind="guestFirstName" placeholder="Adınız" />
                </div>
                <div class="f-group">
                    <label>Soyadınız (*)</label>
                    <input @bind="guestLastName" placeholder="Soyadınız" />
                </div>
                <div class="f-group">
                    <label>E-Posta Adresiniz (*)</label>
                    <input type="email" @bind="guestEmail" placeholder="ornek@mail.com" />
                </div>
                <div class="f-group">
                    <label>Telefon Numaranız (*)</label>
                    <input type="tel" @bind="guestPhone" placeholder="05xx xxx xx xx" />
                </div>
                <div class="f-group">
                    <label>T.C. Kimlik / Pasaport No</label>
                    <input @bind="guestDocNo" placeholder="Kimlik no" />
                </div>
                <div class="f-group">
                    <label>Pansiyon / Konaklama Konsepti (*)</label>
                    <select @bind="boardTypeId" @bind:after="RecalculateSelected">
                        @foreach (var bt in boardTypes)
                        {
                            var isDef = bt.Code == GetHotelDefaultBoardCode(hModal);
                            <option value="@bt.Id">
                                @(bt.Code switch {
                                    "RO" => "🛏️ Sadece Oda (Room Only)",
                                    "BB" => "☕ Oda Kahvaltı (Bed & Breakfast)",
                                    "HB" => "🍽️ Yarım Pansiyon (Sabah + Akşam)",
                                    "FB" => "🍲 Tam Pansiyon (3 Öğün Açık Büfe)",
                                    "AI" => "🍸 Ultra Her Şey Dahil (Tüm İçecek & Öğünler)",
                                    _ => bt.Name
                                })
                                @(bt.PerPersonPerNight > 0 ? $" (+{Fmt.Money(bt.PerPersonPerNight)}/kişi/gece)" : " (Ek Ücretsiz)")
                                @(isDef ? " [Bu Tesisin Standart Konsepti]" : "")
                            </option>
                        }
                    </select>
                </div>
                <div class="f-group full-width">
                    <label>Özel İstekleriniz</label>
                    <textarea rows="2" @bind="bookingNotes" placeholder="Yüksek kat, çift kişilik yatak, geç giriş vb..."></textarea>
                </div>
            </div>

            @if (selectedQuote != null)
            {
                <div class="modal-pricing-box">
                    <div class="sum-row">
                        <span>Konaklama Tutarı (@selectedQuote.Nights Gece):</span>
                        <b>@Fmt.Money(selectedQuote.RoomTotal)</b>
                    </div>
                    @if (selectedQuote.BoardTotal > 0)
                    {
                        <div class="sum-row">
                            <span>Yemek & Pansiyon Bedeli:</span>
                            <b>+@Fmt.Money(selectedQuote.BoardTotal)</b>
                        </div>
                    }
                    <div class="sum-row total">
                        <span>Ödenecek Toplam Tutar:</span>
                        <span class="total-val">@Fmt.Money(selectedQuote.Total)</span>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(modalError))
            {
                <div class="alert bad" style="margin-top:12px">@modalError</div>
            }

            <div style="display:flex;justify-content:flex-end;margin-top:20px;gap:12px">
                <button class="btn-cancel" @onclick="() => showBookingModal = false">İptal</button>
                <button class="btn-primary-large" @onclick="CompleteGuestBooking" disabled="@isSubmitting">
                    @(isSubmitting ? "İşleniyor..." : "⚡ Rezervasyonu Onayla")
                </button>
            </div>
        </div>
    }
</Modal>

<!-- Fotoğraf Büyütme (Lightbox) Modalı -->
@if (showPhotoModal && photoModalRt != null)
{
    var hPhoto = photoModalRt.Hotel ?? hotels.FirstOrDefault(x => x.Id == photoModalRt.HotelId) ?? currentHotel;
    <div class="modal-backdrop" @onclick="() => showPhotoModal = false">
        <div class="photo-modal-card" @onclick:stopPropagation>
            <div class="photo-modal-head">
                <div>
                    <h3>@photoModalRt.Name</h3>
                    <small class="muted">@(hPhoto?.Name) (@(hPhoto?.City)) · @photoModalRt.AreaM2 m² · @photoModalRt.BedType</small>
                </div>
                <button class="close-btn" @onclick="() => showPhotoModal = false">✕</button>
            </div>
            <div class="photo-modal-img-wrap">
                <img src="@GetRoomImage(photoModalRt)" alt="@photoModalRt.Name" class="photo-modal-large" />
            </div>
            <div class="photo-modal-foot">
                <p style="margin:0 0 14px;color:#cbd5e1;font-size:0.92rem">@photoModalRt.Description</p>
                <button class="btn-primary-large" style="width:100%" @onclick="() => { showPhotoModal = false; SelectRoomType(photoModalRt); }">
                    Bu Odayı Seç ve Rezervasyon Yap
                </button>
            </div>
        </div>
    </div>
}

<style>
.booking-portal {
    max-width: 1300px;
    margin: 0 auto;
    padding: 24px 20px 80px;
    color: #f1f5f9;
}
.booking-header {
    text-align: center;
    margin-bottom: 24px;
}
.booking-tag {
    display: inline-block;
    padding: 6px 16px;
    border-radius: 999px;
    background: hsla(172, 78%, 52%, 0.12);
    border: 1px solid hsla(172, 78%, 52%, 0.35);
    color: #2dd4bf;
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 12px;
}
.booking-header h1 {
    font-size: 2.4rem;
    margin: 0 0 8px;
    font-weight: 800;
    letter-spacing: -0.5px;
}
.hotel-sub {
    font-size: 1.05rem;
    color: #94a3b8;
    margin: 0 0 16px;
}

/* 16 Otel Vitrin & Keşif Kartı */
.hotels-explorer-card {
    background: linear-gradient(145deg, hsla(222, 47%, 14%, 0.95), hsla(222, 47%, 10%, 0.95));
    border: 1px solid hsla(217, 33%, 26%, 0.8);
    border-radius: 20px;
    padding: 20px 24px;
    margin-bottom: 24px;
    box-shadow: 0 12px 36px -10px rgba(0, 0, 0, 0.5);
}
.explorer-top-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 18px;
    padding-bottom: 14px;
    border-bottom: 1px solid hsla(217, 33%, 22%, 0.8);
}
.explorer-title-box {
    display: flex;
    align-items: center;
    gap: 12px;
}
.explorer-title-box .icon {
