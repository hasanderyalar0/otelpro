    void ResetFilters()
    {
        selectedBoardCode = null;
        featureFilter = null;
        sortOption = "price_asc";
        SyncDefaultBoardType();
    }

    List<RoomType> filteredRoomTypes
    {
        get
        {
            var list = roomTypes.AsEnumerable();

            if (featureFilter == "sea")
            {
                list = list.Where(r => r.Name.Contains("Deniz", StringComparison.OrdinalIgnoreCase) ||
                                       (r.Description != null && r.Description.Contains("deniz", StringComparison.OrdinalIgnoreCase)));
            }
            else if (featureFilter == "jacuzzi")
            {
                list = list.Where(r => r.Name.Contains("Suit", StringComparison.OrdinalIgnoreCase) ||
                                       (r.Description != null && r.Description.Contains("jakuzi", StringComparison.OrdinalIgnoreCase)));
            }
            else if (featureFilter == "family")
            {
                list = list.Where(r => r.MaxCapacity >= 4 || r.Name.Contains("Aile", StringComparison.OrdinalIgnoreCase));
            }
            else if (featureFilter == "balcony")
            {
                list = list.Where(r => r.Name.Contains("Deluxe", StringComparison.OrdinalIgnoreCase) ||
                                       r.Name.Contains("Deniz", StringComparison.OrdinalIgnoreCase));
            }

            if (sortOption == "price_asc")
            {
                list = list.OrderBy(r => quoteMap.TryGetValue(r.Id, out var q) ? q.Total : r.BasePrice);
            }
            else if (sortOption == "price_desc")
            {
                list = list.OrderByDescending(r => quoteMap.TryGetValue(r.Id, out var q) ? q.Total : r.BasePrice);
            }
            else if (sortOption == "capacity")
            {
                list = list.OrderByDescending(r => r.MaxCapacity);
            }

            return list.ToList();
        }
    }

    async Task SearchRooms()
    {
        if (checkOut <= checkIn) checkOut = checkIn.AddDays(1);
        availableMap.Clear();
        quoteMap.Clear();

        if (selectedHotelId == 0)
        {
            roomTypes = await Db.RoomTypes.Include(r => r.Hotel).ToListAsync();
        }
        else
        {
            roomTypes = await Db.RoomTypes.Include(r => r.Hotel).Where(r => r.HotelId == selectedHotelId).ToListAsync();
        }

        foreach (var rt in roomTypes)
        {
            var free = await Booking.FreeRoomsAsync(checkIn, checkOut, rt.Id);
            availableMap[rt.Id] = free.Count;

            var effectiveBoardId = boardTypeId;
            if (selectedBoardCode == null)
            {
                var h = rt.Hotel ?? hotels.FirstOrDefault(x => x.Id == rt.HotelId) ?? currentHotel;
                var defCode = GetHotelDefaultBoardCode(h);
                var bObj = boardTypes.FirstOrDefault(b => b.Code == defCode);
                if (bObj != null) effectiveBoardId = bObj.Id;
            }

            var q = await Booking.QuoteAsync(rt.Id, checkIn, checkOut, adults, children, effectiveBoardId, null);
            quoteMap[rt.Id] = q;
        }
    }

