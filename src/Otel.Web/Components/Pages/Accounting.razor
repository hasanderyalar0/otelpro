@page "/accounting"
@inject AppDb Db
@inject BookingService Booking
@inject HotelState CurrentHotelState

<div class="page-head">
    <div>
        <div style="display:flex;align-items:center;gap:10px">
            <h1>@L["nav.accounting"] & Finans Radarı</h1>
            <span class="badge b-ok" style="font-size:0.85rem">🏢 @(CurrentHotelState.SelectedHotel?.Name ?? "Tesis")</span>
        </div>
        <p>@(L.Lang == "tr" ? "Ön Muhasebe, Kasa Hareketleri, Gün Sonu Kapatma (Night Audit), Faturalar ve AI 30 Günlük Nakit Akışı Radarı" : "Cash registers, Night Audit, billing, and AI 30-Day Cashflow Forecasting")</p>
    </div>
    <div class="row">
        <button class="btn danger sm" @onclick="RunNightAudit" disabled="@isClosing">
            🌙 @(isClosing ? "Kapatılıyor..." : (L.Lang == "tr" ? "Gün Sonu Kapat (Night Audit)" : "Run Day Closing"))
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(auditMsg))
{
    <div class="alert ok mb" style="display:flex;justify-content:space-between;align-items:center">
        <span>@auditMsg</span>
        <button class="btn sm" style="padding:2px 8px;font-size:0.75rem" @onclick="() => auditMsg = null">✕</button>
    </div>
}

<div class="grid g3 mb">
    @foreach (var c in cashRegisters)
    {
        <div class="card kpi">
            <span class="ico">💵</span>
            <div class="label">@c.Name</div>
            <div class="val">@Fmt.Money(c.Balance)</div>
            <div class="sub">Nakit Kasa Bakiyesi</div>
        </div>
    }
    <div class="card kpi">
        <span class="ico">🧾</span>
        <div class="label">Toplam Kesilen Fatura</div>
        <div class="val">@invoices.Count</div>
        <div class="sub">@Fmt.Money(invoices.Sum(i => i.Total)) Toplam Tutar</div>
    </div>
</div>

<div class="tabs mb">
    <button class="@(tab == "invoices" ? "on" : "")" @onclick='() => tab = "invoices"'>Faturalar (@invoices.Count)</button>
    <button class="@(tab == "closings" ? "on" : "")" @onclick='() => tab = "closings"'>Gün Sonu Geçmişi</button>
    <button class="@(tab == "cashflow" ? "on" : "")" @onclick='() => tab = "cashflow"'>
        🔮 AI 30 Günlük Nakit Akışı & Likidite Radarı
    </button>
</div>

@if (tab == "invoices")
{
    <div class="card" style="padding:6px">
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Fatura No</th>
                        <th>Tarih</th>
                        <th>Tür</th>
                        <th class="num">Matrah</th>
                        <th class="num">KDV</th>
                        <th class="num">Toplam</th>
                        <th>Durum</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inv in invoices)
                    {
                        <tr>
                            <td><b>@inv.Number</b></td>
                            <td>@Fmt.D(inv.Date)</td>
                            <td>@(inv.IsEInvoice ? "e-Fatura" : "Matbu Fatura")</td>
                            <td class="num">@Fmt.Money(inv.Subtotal)</td>
                            <td class="num">@Fmt.Money(inv.Tax)</td>
                            <td class="num"><b>@Fmt.Money(inv.Total)</b></td>
                            <td><span class="badge b-ok">@inv.Status</span></td>
                        </tr>
                    }
                    @if (invoices.Count == 0)
                    {
                        <tr><td colspan="7" class="muted">Kayıtlı fatura bulunmuyor.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else if (tab == "closings")
{
    <div class="card" style="padding:6px">
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>İşlem Tarihi</th>
                        <th>Toplam Hasılat</th>
                        <th>Kapanış Zamanı</th>
                        <th>Doluluk (Oda)</th>
                        <th>Durum</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in dayClosings)
                    {
                        <tr>
                            <td><b>@Fmt.D(d.BusinessDate)</b></td>
                            <td style="color:#22c55e;font-weight:700">@Fmt.Money(d.TotalRevenue)</td>
                            <td><small>@Fmt.DT(d.ClosedAt)</small></td>
                            <td><small>@d.OccupiedRooms / @d.TotalRooms Oda</small></td>
                            <td><span class="badge b-ok">Başarılı</span></td>
                        </tr>
                    }
                    @if (dayClosings.Count == 0)
                    {
                        <tr><td colspan="5" class="muted">Henüz gün sonu işlemi kaydedilmemiş.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <!-- TAB 3: AI NAKİT AKIŞI & LİKİDİTE RADARI -->
    <div class="grid g4 mb">
        <div class="card kpi">
            <span class="ico">📈</span>
            <div class="label">30 Günlük Beklenen Tahsilat</div>
            <div class="val" style="color:#22c55e">@Fmt.Money(expectedInflow)</div>
            <div class="sub">Onaylı Rezervasyonlar + OTA</div>
        </div>
        <div class="card kpi">
            <span class="ico">📉</span>
            <div class="label">Planlanan Giderler</div>
            <div class="val" style="color:#f43f5e">@Fmt.Money(expectedOutflow)</div>
            <div class="sub">Maaşlar, Enerji, Tedarikçiler</div>
        </div>
        <div class="card kpi">
            <span class="ico">💰</span>
            <div class="label">Net Nakit Pozisyonu</div>
            <div class="val" style="color:#38bdf8">@Fmt.Money(expectedInflow - expectedOutflow)</div>
            <div class="sub">Tahmini Ay Sonu Fazlası</div>
        </div>
        <div class="card kpi">
            <span class="ico">🛡️</span>
            <div class="label">Likidite Güvenlik Skoru</div>
            <div class="val" style="color:@(liquidityRiskPct < 15 ? "#22c55e" : "#f59e0b")">
                %@(100 - liquidityRiskPct)
            </div>
            <div class="sub">Finansal Sağlık Skoru</div>
        </div>
    </div>

    <!-- AI Erken Uyarı ve Stratejik Öneri Kartı -->
    <div class="card mb" style="background:linear-gradient(135deg, rgba(2,132,199,0.15), rgba(99,102,241,0.15));border:1px solid rgba(56,189,248,0.4);padding:16px 20px">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:12px">
            <div>
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px">
                    <span style="font-size:1.4rem">🔮</span>
                    <b style="color:#fff;font-size:1.05rem">Yapay Zeka Finansal Likidite Analizi</b>
                    <span class="badge @(isCampaignActive ? "b-ok" : "b-warn")">
                        @(isCampaignActive ? "✓ Kampanya Devrede" : "⚡ Aksiyon Önerisi")
                    </span>
                </div>
                <p style="margin:0 0 10px 0;font-size:0.88rem;color:#cbd5e1;line-height:1.5">
                    @if (isCampaignActive)
                    {
                        <span>
                            <b>Harika!</b> Web sitesi doğrudan peşin ödemeli rezervasyon kampanyası (%8 indirim) devrede. Erken nakit girişi tahmini <b>+145.000 ₺</b> artırıldı ve ay ortası likidite riski <b>%4'e</b> geriledi.
                        </span>
                    }
                    else
                    {
                        <span>
                            Önümüzdeki ayın 15'inde personel maaş ödemeleri ve toptancı gıda tedarik faturaları (toplam 380.000 ₺) aynı haftaya denk gelmektedir. Tahmini kasa likidite riski: <b>%18</b>.
                        </span>
                    }
                </p>
            </div>

            @if (!isCampaignActive)
            {
                <button class="btn primary" style="font-weight:700;padding:10px 18px" @onclick="ActivatePrepayCampaign">
                    🚀 Erken Rezervasyon Peşin İndirimi Başlat
                </button>
            }
        </div>
    </div>

    <!-- 30 Günlük Projeksiyon Çizelgesi -->
    <div class="card">
        <h3>Haftalık Nakit Akışı Dağılımı (4 Hafta Projeksiyonu)</h3>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Dönem</th>
                        <th>Beklenen Tahsilat (Giriş)</th>
                        <th>Sabit & Değişken Giderler (Çıkış)</th>
                        <th>Net Dönem Farkı</th>
                        <th>Kasa Güvenlik Durumu</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><b>1. Hafta (1 - 7 Gün)</b></td>
                        <td style="color:#22c55e;font-weight:600">+@Fmt.Money(420000)</td>
                        <td style="color:#f43f5e">-@Fmt.Money(180000)</td>
                        <td style="color:#38bdf8;font-weight:700">+@Fmt.Money(240000)</td>
                        <td><span class="badge b-ok">✓ Çok Güçlü</span></td>
                    </tr>
                    <tr>
                        <td><b>2. Hafta (8 - 14 Gün)</b></td>
                        <td style="color:#22c55e;font-weight:600">+@Fmt.Money(390000)</td>
                        <td style="color:#f43f5e">-@Fmt.Money(480000) <small class="muted">(Maaşlar)</small></td>
                        <td style="color:@(isCampaignActive ? "#38bdf8" : "#f59e0b");font-weight:700">
                            @(isCampaignActive ? "+" + Fmt.Money(55000) : "-" + Fmt.Money(90000))
                        </td>
                        <td>
                            <span class="badge @(isCampaignActive ? "b-ok" : "b-warn")">
                                @(isCampaignActive ? "✓ Denglendi" : "⚠️ Dikkat")
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <td><b>3. Hafta (15 - 21 Gün)</b></td>
                        <td style="color:#22c55e;font-weight:600">+@Fmt.Money(510000)</td>
                        <td style="color:#f43f5e">-@Fmt.Money(240000)</td>
                        <td style="color:#38bdf8;font-weight:700">+@Fmt.Money(270000)</td>
                        <td><span class="badge b-ok">✓ Çok Güçlü</span></td>
                    </tr>
                    <tr>
                        <td><b>4. Hafta (22 - 30 Gün)</b></td>
                        <td style="color:#22c55e;font-weight:600">+@Fmt.Money(520000)</td>
                        <td style="color:#f43f5e">-@Fmt.Money(220000)</td>
                        <td style="color:#38bdf8;font-weight:700">+@Fmt.Money(300000)</td>
                        <td><span class="badge b-ok">✓ Mükemmel</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    string tab = "invoices";
    List<CashRegister> cashRegisters = new();
    List<Invoice> invoices = new();
    List<DayClosing> dayClosings = new();
    bool isClosing;
    string? auditMsg;

    // AI Cashflow Değişkenleri
    decimal expectedInflow = 1840000;
    decimal expectedOutflow = 1120000;
    int liquidityRiskPct = 18;
    bool isCampaignActive = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    async Task LoadData()
    {
        cashRegisters = await Db.CashRegisters.ToListAsync();
        invoices = await Db.Invoices.OrderByDescending(i => i.Id).Take(50).ToListAsync();
        dayClosings = await Db.DayClosings.OrderByDescending(d => d.BusinessDate).Take(30).ToListAsync();
    }

    void ActivatePrepayCampaign()
    {
        isCampaignActive = true;
        expectedInflow += 145000;
        liquidityRiskPct = 4;
        auditMsg = "🚀 Erken Rezervasyon %8 Peşin İndirim Kampanyası doğrudan rezervasyon motorunda (/book) aktif edildi! Kasa nakit akışı güçlendirildi.";
    }

    async Task RunNightAudit()
    {
        isClosing = true;
        auditMsg = null;
        try
        {
            var yesterday = DateTime.Today.AddDays(-1);
            await Db.Database.ExecuteSqlRawAsync("EXEC sp_DayClosing @BusinessDate = {0}, @UserId = {1}", yesterday, 1);
            auditMsg = $"{yesterday:dd.MM.yyyy} günü için Night Audit başarıyla tamamlandı. Otel gelirleri muhasebeleştirildi.";
            await LoadData();
        }
        catch (Exception ex)
        {
            auditMsg = "Hata: " + (ex.InnerException?.Message ?? ex.Message);
        }
        finally
        {
            isClosing = false;
        }
    }
}
