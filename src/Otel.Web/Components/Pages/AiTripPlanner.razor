                </div>

                <div class="modal-footer" style="padding:12px 24px;display:flex;justify-content:flex-end">
                    <button class="btn sm" @onclick="CloseAskGuideModal">Kapat</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    List<Hotel> hotels = new();
    int selectedHotelId = 1;
    int selectedDays = 1;
    string selectedProfile = "romantic";
    string selectedPace = "relaxed";
    string selectedBudget = "luxury";
    DateTime selectedStartDate = DateTime.Today;
    int selectedAdults = 2;
    int selectedChildren = 0;
    string selectedTransport = "vip";
    List<string> selectedPreferences = new() { "sunset" };
    string customAiPrompt = "";
    bool isGenerating = false;
    bool isSpeaking = false;
    string mapTheme = "dark";
    bool isMapExpanded = false;

    TripPlan? currentPlan;
    int activeDayTab = 1;

    // Modallar
    bool showWhatsAppModal = false;
    string targetWhatsAppPhone = "";
    bool showFolioModal = false;
    int selectedFolioReservationId = 0;
    int folioGuestCount = 2;
    string? folioSuccessMsg = null;
    List<Reservation> inHouseGuests = new();

    // AI Tur Rehberine Soru Sorma & Bireysel Durak Dinleme
    bool showAskGuideModal = false;
    ItineraryStop? activeGuideStop;
    string guideCustomQuestion = "";
    string guideAnswerText = "";
    bool isGuideAnswering = false;
    bool isGuideSpeaking = false;
    int? activePlayingStopId = null;

    List<ItineraryStop> ActiveDayStops => currentPlan?.Stops.Where(s => s.Day == activeDayTab).ToList() ?? new();

    string GeneratedWhatsAppText => GetGeneratedWhatsAppText();

    string GetGeneratedWhatsAppText()
    {
        if (currentPlan == null) return "";
        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"🌟 *{currentPlan.Hotel.Name} - {currentPlan.ProfileTitle}*");
        var childrenText = currentPlan.Children > 0 ? $" + {currentPlan.Children} Çocuk" : "";
        sb.AppendLine($"📍 Şehir: {currentPlan.Hotel.City} | ⏱️ {currentPlan.Days} Günlük Plan | 📅 {currentPlan.StartDate:dd MMMM yyyy}");
        sb.AppendLine($"👥 Misafir: {currentPlan.Adults} Yetişkin{childrenText}");
        sb.AppendLine($"🚗 Ulaşım: {currentPlan.TransportTitle}");
        sb.AppendLine($"☀️ Hava Durumu: {currentPlan.Weather.TempC}°C {currentPlan.Weather.Condition}");
        sb.AppendLine();
        for (int i = 0; i < ActiveDayStops.Count; i++)
        {
            var s = ActiveDayStops[i];
            sb.AppendLine($"*{i + 1}. {s.TimeSlot}* - {s.CategoryIcon} {s.Title}");
            sb.AppendLine($"📍 {s.DistanceText} ({s.TransitText})");
            sb.AppendLine($"⭐ {s.Specialty}");
            sb.AppendLine($"💡 İpucu: {s.ConciergeTip}");
            sb.AppendLine($"💰 Tahmini: ~₺{s.EstCost}");
            sb.AppendLine();
        }
        sb.AppendLine($"🎒 *Tavsiyeler:* {string.Join(", ", currentPlan.PackingTips.Take(3))}");
        sb.AppendLine();
        sb.AppendLine($"Otel İletişim: {currentPlan.Hotel.Phone ?? "+90 242 000 00 00"}");
        return sb.ToString();
    }

    bool mapRenderedOnce = false;

    protected override async Task OnInitializedAsync()
    {
        hotels = await TripPlanner.GetHotelsAsync();
        selectedHotelId = HotelState.SelectedHotelId > 0 ? HotelState.SelectedHotelId : (hotels.FirstOrDefault()?.Id ?? 1);
        
        // İlk açılışta zengin bir rota otomatik oluşturulsun
        await GenerateRouteAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || (!mapRenderedOnce && currentPlan != null))
        {
            mapRenderedOnce = true;
            await Task.Delay(350);
            await RenderMapAsync();
        }
    }

    async Task OnHotelChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var newId))
        {
            selectedHotelId = newId;
            await GenerateRouteAsync();
        }
    }

    async Task SelectProfileAsync(string profile)
    {
        selectedProfile = profile;
        await GenerateRouteAsync();
    }

    async Task ChangeDaysAsync(int days)
    {
        selectedDays = days;
        await GenerateRouteAsync();
    }

    async Task OnPaceChanged(ChangeEventArgs e)
    {
        selectedPace = e.Value?.ToString() ?? "relaxed";
        await GenerateRouteAsync();
    }

    async Task OnBudgetChanged(ChangeEventArgs e)
    {
        selectedBudget = e.Value?.ToString() ?? "luxury";
        await GenerateRouteAsync();
    }

    async Task OnStartDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var d))
        {
            selectedStartDate = d;
            await GenerateRouteAsync();
        }
    }

    async Task OnAdultsChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var a))
        {
            selectedAdults = a;
            folioGuestCount = a + selectedChildren;
            await GenerateRouteAsync();
        }
    }

    async Task OnChildrenChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var c))
        {
            selectedChildren = c;
            folioGuestCount = selectedAdults + c;
            await GenerateRouteAsync();
        }
    }

    async Task OnTransportChanged(ChangeEventArgs e)
    {
        selectedTransport = e.Value?.ToString() ?? "vip";
        await GenerateRouteAsync();
    }

    async Task TogglePreference(string key)
    {
        if (selectedPreferences.Contains(key))
            selectedPreferences.Remove(key);
        else
            selectedPreferences.Add(key);

        await GenerateRouteAsync();
    }

    async Task ApplyQuickPrompt(string text)
    {
        customAiPrompt = text;
        await GenerateRouteAsync();
    }

    async Task OnPromptKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await GenerateRouteAsync();
        }
    }

    async Task GenerateRouteAsync()
    {
        isGenerating = true;
        StateHasChanged();

        await Task.Delay(350); // Şık AI hesaplama efekti
        currentPlan = await TripPlanner.GenerateItineraryAsync(
            selectedHotelId, 
            selectedProfile, 
            selectedDays, 
            selectedPace, 
            selectedBudget,
            selectedStartDate,
            selectedAdults,
            selectedChildren,
            selectedTransport,
            selectedPreferences,
            customAiPrompt);

        activeDayTab = 1;
        isGenerating = false;
        StateHasChanged();

        await Task.Delay(150);
        await RenderMapAsync();
    }

    async Task SwitchDayTab(int dayNum)
    {
        activeDayTab = dayNum;
        StateHasChanged();
        await Task.Delay(100);
        await RenderMapAsync();
    }

    async Task RenderMapAsync()
    {
        if (currentPlan == null) return;
        var stops = ActiveDayStops;
        try
        {
            await JS.InvokeVoidAsync("renderTripItineraryRoute", 
                "tripPlannerMap", 
                currentPlan.Hotel.Latitude ?? 36.855, 
                currentPlan.Hotel.Longitude ?? 30.795, 
                currentPlan.Hotel.Name, 
                stops);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Trip planner map error: {ex.Message}");
        }
    }

    async Task FocusStopOnMap(ItineraryStop stop)
    {
        await JS.InvokeVoidAsync("focusTripPlannerStop", stop.Latitude, stop.Longitude, 16, stop.Id);
    }

    async Task ResetMapZoom()
    {
        await JS.InvokeVoidAsync("fitTripPlannerBounds");
    }

    async Task ChangeMapTheme(string theme)
    {
        mapTheme = theme;
        await JS.InvokeVoidAsync("setTripPlannerMapTheme", theme);
    }

    async Task ToggleMapExpand()
    {
        isMapExpanded = !isMapExpanded;
        StateHasChanged();
        await Task.Delay(250);
        await JS.InvokeVoidAsync("invalidateTripPlannerMap");
        await JS.InvokeVoidAsync("fitTripPlannerBounds");
    }

    async Task ToggleSpeechAsync()
    {
        if (isSpeaking)
        {
            isSpeaking = false;
            await JS.InvokeVoidAsync("stopSpeech");
        }
        else
        {
            if (currentPlan == null) return;
            isSpeaking = true;
            var text = $"{currentPlan.Hotel.Name} için {activeDayTab}. gün rotası başlıyor. {currentPlan.ProfileTitle}. Bugün {ActiveDayStops.Count} seçkin durağımız var. ";
            foreach (var stop in ActiveDayStops)
            {
                text += $"Saat {stop.TimeSlot}, {stop.Title}. {stop.Specialty}. ";
            }
            text += $"Hava durumu {currentPlan.Weather.TempC} derece ve {currentPlan.Weather.Condition}. Harika bir tatil dileriz.";
            await JS.InvokeVoidAsync("playSpeechText", text);
        }
    }

    async Task DownloadIcsCalendar()
    {
        if (currentPlan == null) return;
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("BEGIN:VCALENDAR");
        sb.AppendLine("VERSION:2.0");
        sb.AppendLine("PRODID:-//OtelPro//AI Trip Planner//TR");
        sb.AppendLine("CALSCALE:GREGORIAN");
        sb.AppendLine("METHOD:PUBLISH");

        var planDate = selectedStartDate;
        foreach (var stop in currentPlan.Stops)
        {
            var dayOffset = Math.Max(0, stop.Day - 1);
            var date = planDate.AddDays(dayOffset);
            
            var times = stop.TimeSlot.Split('-');
            var startTimeStr = times.Length > 0 ? times[0].Trim() : "09:00";
            var endTimeStr = times.Length > 1 ? times[1].Trim() : "11:00";
            
            DateTime startDt = date.Date;
            if (TimeSpan.TryParse(startTimeStr, out var ts1)) startDt = startDt.Add(ts1);
            else startDt = startDt.AddHours(9);

            DateTime endDt = date.Date;
            if (TimeSpan.TryParse(endTimeStr, out var ts2)) endDt = endDt.Add(ts2);
            else endDt = endDt.AddHours(11);

            sb.AppendLine("BEGIN:VEVENT");
            sb.AppendLine($"UID:trip-{currentPlan.Hotel.Id}-{stop.Id}-{Guid.NewGuid():N}@otelpro.com");
            sb.AppendLine($"DTSTAMP:{DateTime.UtcNow:yyyyMMddTHHmmssZ}");
            sb.AppendLine($"DTSTART:{startDt:yyyyMMddTHHmmss}");
            sb.AppendLine($"DTEND:{endDt:yyyyMMddTHHmmss}");
            sb.AppendLine($"SUMMARY:{EscapeIcs(stop.CategoryIcon + " " + stop.Title)}");
            sb.AppendLine($"DESCRIPTION:{EscapeIcs(stop.Description + "\n⭐ " + stop.Specialty + "\n💡 Concierge: " + stop.ConciergeTip)}");
            sb.AppendLine($"LOCATION:{EscapeIcs(stop.Address)}");
            sb.AppendLine($"GEO:{stop.Latitude:F6};{stop.Longitude:F6}");
            sb.AppendLine("STATUS:CONFIRMED");
            sb.AppendLine("END:VEVENT");
        }

        sb.AppendLine("END:VCALENDAR");
        var filename = $"OtelPro_Tatil_Plani_{currentPlan.Hotel.City}_{DateTime.Now:yyyyMMdd}.ics";
        await JS.InvokeVoidAsync("downloadIcsFile", filename, sb.ToString());
    }

    static string EscapeIcs(string text)
    {
        if (string.IsNullOrEmpty(text)) return "";
        return text.Replace("\\", "\\\\").Replace(";", "\\;").Replace(",", "\\,").Replace("\n", "\\n").Replace("\r", "");
    }

    void OpenWhatsAppModal()
    {
        showWhatsAppModal = true;
    }

    async Task CopyWhatsAppText()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", GeneratedWhatsAppText);
    }

    async Task OpenFolioModal()
    {
        folioSuccessMsg = null;
        showFolioModal = true;
        try
        {
            inHouseGuests = await BookingSvc.GetInHouseReservationsAsync(selectedHotelId);
            if (inHouseGuests.Count > 0 && selectedFolioReservationId == 0)
            {
                selectedFolioReservationId = inHouseGuests[0].Id;
            }
        }
        catch { }
    }

    async Task ChargeToRoomFolio()
    {
        if (selectedFolioReservationId == 0 || currentPlan == null) return;

        var res = inHouseGuests.FirstOrDefault(r => r.Id == selectedFolioReservationId);
        if (res?.Folio != null)
        {
            var total = currentPlan.TotalCostPerPerson * folioGuestCount;
            await BookingSvc.AddChargeAsync(res.Folio.Id, $"VIP AI Gezi Programı ({currentPlan.ProfileTitle} - {folioGuestCount} Kişi)", ChargeCategory.Other, 1, total, 20);
            folioSuccessMsg = $"✅ {Fmt.Money(total)} tutarındaki gezi paketi {res.Guest?.FullName} folyosuna başarıyla işlendi!";
            StateHasChanged();
        }
    }

    async Task PrintItinerary()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    void OpenAskGuideModal(ItineraryStop? stop)
    {
        activeGuideStop = stop ?? ActiveDayStops.FirstOrDefault();
        guideCustomQuestion = "";
        guideAnswerText = "";
        isGuideSpeaking = false;
        showAskGuideModal = true;
    }

    void CloseAskGuideModal()
    {
        showAskGuideModal = false;
        if (isGuideSpeaking)
        {
            isGuideSpeaking = false;
            _ = JS.InvokeVoidAsync("stopSpeech");
        }
    }

    async Task AskGuidePresetQuestion(string question)
    {
        guideCustomQuestion = question;
        await SubmitGuideCustomQuestion();
    }

    async Task SubmitGuideCustomQuestion()
    {
        if (activeGuideStop == null || currentPlan == null || string.IsNullOrWhiteSpace(guideCustomQuestion)) return;
        isGuideAnswering = true;
        StateHasChanged();

        await Task.Delay(250);
        guideAnswerText = await TripPlanner.AskGuideAboutStopAsync(currentPlan.Guide, activeGuideStop, guideCustomQuestion, currentPlan);
        isGuideAnswering = false;
        StateHasChanged();
    }

    async Task OnGuideQuestionKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SubmitGuideCustomQuestion();
        }
    }

    async Task ToggleGuideAnswerSpeech()
    {
        if (isGuideSpeaking)
        {
            isGuideSpeaking = false;
            await JS.InvokeVoidAsync("stopSpeech");
        }
        else
        {
            if (string.IsNullOrWhiteSpace(guideAnswerText) || currentPlan == null) return;
            isGuideSpeaking = true;
            var text = $"{currentPlan.Guide.Name} aktarıyor: {guideAnswerText}";
            await JS.InvokeVoidAsync("playSpeechText", text);
        }
    }

    async Task PlayStopSpeech(ItineraryStop stop)
    {
        if (activePlayingStopId == stop.Id)
        {
            activePlayingStopId = null;
            await JS.InvokeVoidAsync("stopSpeech");
        }
        else
        {
            activePlayingStopId = stop.Id;
            var text = $"{stop.Title}. {stop.CategoryName}. Saat {stop.TimeSlot}. Bu durakta: {stop.Specialty}. Rehber tüyosu: {stop.ConciergeTip}. Tahmini bütçe kişi başı yaklaşık {stop.EstCost} Türk Lirası.";
            await JS.InvokeVoidAsync("playSpeechText", text);
        }
    }

    static string FormatWhatsApp(string phone)
    {
        if (string.IsNullOrWhiteSpace(phone)) return "";
        var digits = new string(phone.Where(char.IsDigit).ToArray());
        if (digits.StartsWith("0")) digits = "90" + digits.Substring(1);
        if (!digits.StartsWith("90") && digits.Length == 10) digits = "90" + digits;
        return digits;
    }
}
