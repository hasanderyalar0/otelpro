                    <!-- Hızlı Soru Şablonları -->
                    <div style="margin-top:14px">
                        <label style="font-size:0.78rem;color:#cbd5e1;font-weight:700;margin-bottom:6px;display:block">Rehbere Hızlı Soru Sorun:</label>
                        <div class="guide-quick-questions">
                            <button type="button" class="g-q-chip" @onclick='() => AskGuidePresetQuestion("Bu durak için ne giymeliyim, kıyafet öneriniz nedir?")'>
                                👔 Ne Giymeliyim?
                            </button>
                            <button type="button" class="g-q-chip" @onclick='() => AskGuidePresetQuestion("Önceden rezervasyon veya bilet gerekli mi, otel önceliğimiz var mı?")'>
                                🎟️ Rezervasyon & Bilet
                            </button>
                            <button type="button" class="g-q-chip" @onclick='() => AskGuidePresetQuestion("En iyi fotoğraf ve manzara noktası neresidir?")'>
                                📸 En İyi Fotoğraf Noktası
                            </button>
                            <button type="button" class="g-q-chip" @onclick='() => AskGuidePresetQuestion("Burası çocuklar ve bebek arabası için uygun mu?")'>
                                👶 Çocuk & Aile Uygunluğu
                            </button>
                            <button type="button" class="g-q-chip" @onclick='() => AskGuidePresetQuestion("Otel misafirlerine özel indirim veya karşılama ikramı var mı?")'>
                                🎁 Otel İkramı & İndirim
                            </button>
                            <button type="button" class="g-q-chip" @onclick='() => AskGuidePresetQuestion("Yağmur veya kötü hava durumunda alternatif öneriniz nedir?")'>
                                🔀 Alternatif / Kötü Hava
                            </button>
                        </div>
                    </div>

                    <!-- Soru Kutusu -->
                    <div class="guide-input-row" style="margin-top:14px">
                        <input type="text" class="custom-select" style="flex:1" placeholder="Örn: Akşam masası için deniz kenarı yer ayrılabilir mi?..." 
                               @bind="guideCustomQuestion" @bind:event="oninput" @onkeydown="OnGuideQuestionKeyDown" />
                        <button class="btn primary" @onclick="SubmitGuideCustomQuestion" disabled="@isGuideAnswering" style="padding:10px 18px">
                            @if (isGuideAnswering)
                            {
                                <span>Cevaplanıyor...</span>
                            }
                            else
                            {
                                <span>Sor</span>
                            }
                        </button>
                    </div>

                    <!-- Rehberin Cevabı -->
                    @if (!string.IsNullOrWhiteSpace(guideAnswerText))
                    {
                        <div class="guide-answer-card">
                            <div class="guide-answer-head">
                                <div style="display:flex;align-items:center;gap:8px">
                                    <span style="font-size:1.2rem">@currentPlan.Guide.Avatar</span>
                                    <b style="color:#fff;font-size:0.85rem">@currentPlan.Guide.Name'in Rehberlik Tavsiyesi:</b>
                                </div>
                                <button class="guide-answer-speech-btn" @onclick="ToggleGuideAnswerSpeech">
                                    @(isGuideSpeaking ? "⏹️ Durdur" : "🔊 Sesli Dinle")
