    async Task SaveNewHotel()
    {
        if (string.IsNullOrWhiteSpace(newHotel.Name))
        {
            hotelFormError = "Lütfen otel adını giriniz.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newHotel.City))
        {
            hotelFormError = "Lütfen şehir / bölge bilgisini giriniz.";
            return;
        }

        try
        {
            await NearbySvc.AddHotelAsync(newHotel);
            showAddHotelModal = false;
            await LoadDataAsync();
            await SelectHotel(newHotel.Id);
        }
        catch (Exception ex)
        {
            hotelFormError = $"Kayıt hatası: {ex.Message}";
        }
    }

    void OpenAddPlaceModal()
    {
        newPlace = new NearbyPlace
        {
            HotelId = selectedHotelId ?? (hotels.Count > 0 ? hotels[0].Id : 1),
            Category = "Activity",
            PriceLevel = 3,
            Rating = 4.9m,
            ReviewCount = 100,
            ImageUrl = "/images/boat_tour.jpg",
            WorkingHours = "09:30 - 18:00",
            Latitude = selectedHotel?.Latitude,
            Longitude = selectedHotel?.Longitude
        };
        placeFormError = "";
        showAddPlaceModal = true;
    }

    async Task SaveNewPlace()
    {
        if (string.IsNullOrWhiteSpace(newPlace.Name))
        {
            placeFormError = "Lütfen mekan veya aktivite adını giriniz.";
            return;
        }

        if (newPlace.DistanceMeters <= 0)
        {
            placeFormError = "Lütfen geçerli bir mesafe giriniz.";
            return;
        }

        try
        {
            await NearbySvc.AddAsync(newPlace);
            showAddPlaceModal = false;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            placeFormError = $"Kayıt sırasında hata oluştu: {ex.Message}";
        }
    }

