    async Task LoadInHouseGuestsAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var q = db.Reservations
                .Include(r => r.Guest)
                .Include(r => r.Rooms).ThenInclude(rm => rm.Room)
                .Where(r => r.Status == ResStatus.CheckedIn);

            if (selectedHotelId.HasValue)
            {
                q = q.Where(r => r.Rooms.Any(rm => rm.Room != null && rm.Room.HotelId == selectedHotelId.Value));
            }

            var res = await q.Take(25).ToListAsync();

            inHouseGuests = res
                .Where(r => r.Guest != null)
                .Select(r => new GuestOption(
                    r.Guest!.Id,
                    $"{r.Guest.FirstName} {r.Guest.LastName}",
                    r.Rooms.FirstOrDefault()?.Room?.Number ?? "Oda ?",
                    r.Guest.Phone ?? ""
                ))
                .ToList();
        }
        catch
        {
            // fallback
        }
    }

    void OnGuestSelected()
    {
        var g = inHouseGuests.FirstOrDefault(x => x.Id == selectedGuestId);
        if (g != null)
        {
            guestName = g.FullName;
            guestRoomNumber = g.RoomNumber;
            guestPhone = g.Phone;
        }
        GenerateRecommendationText();
    }

    void OnConciergePlaceChanged()
    {
