    }

    void GenerateRecommendationText()
    {
        var place = allPlaces.FirstOrDefault(p => p.Id == conciergePlaceId) ?? allPlaces.FirstOrDefault();
        if (place == null) return;

        var dist = GetCalculatedDistance(place);
        string hotelTitle = selectedHotel?.Name ?? place.Hotel?.Name ?? "Otel";
        string roomInfo = string.IsNullOrWhiteSpace(guestRoomNumber) ? "" : $" (Oda {guestRoomNumber})";
        string discountPart = place.IsPartner && !string.IsNullOrEmpty(place.HotelDiscountNote)
            ? $"\n\n🎁 Otel Misafirlerimize Özel Ayrıcalık: {place.HotelDiscountNote}"
            : "";

        string distanceStr = dist.meters < 1000 ? $"{dist.meters} metre" : $"{(dist.meters / 1000.0):0.#} km";
        string timeStr = dist.meters <= 1200 ? $" (Yürüyerek yaklaşık {dist.walk} dakika)" : $" (Araç / transfer ile yaklaşık {dist.drive} dakika)";

        conciergeGeneratedText =
            $"Sayın {guestName}{roomInfo},\n\n" +
            $"{hotelTitle} Ön Büro & Concierge ekibimiz olarak gününüzü unutulmaz kılacak harika bir aktivite ve mekan önerimiz var:\n\n" +
            $"🌟 {place.Name} ({place.SubCategory})\n" +
            $"📍 Mesafe: Otelimize {distanceStr}{timeStr}\n" +
            $"🕒 Tur / Çalışma Saatleri: {place.WorkingHours}\n" +
            $"📞 İletişim: {place.Phone}\n" +
            $"✨ Öne Çıkanlar: {place.Specialties ?? place.Description}" +
            $"{discountPart}\n\n" +
            $"Haritada Aç: {place.GoogleMapsUrl}\n\n" +
            $"Rezervasyon yaptırmak veya transfer talep etmek isterseniz resepsiyonumuzla dilediğiniz zaman iletişime geçebilirsiniz! 🌴🌊";
    }

    async Task CopyMessageToClipboard()
    {
        try
