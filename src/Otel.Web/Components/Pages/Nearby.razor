    // Seçili otele göre dinamik Haversine mesafe hesaplaması
    (int meters, int walk, int drive) GetCalculatedDistance(NearbyPlace place)
    {
        if (selectedHotel?.Latitude != null && selectedHotel?.Longitude != null &&
            place.Latitude.HasValue && place.Longitude.HasValue)
        {
            double dLat = (place.Latitude.Value - selectedHotel.Latitude.Value) * Math.PI / 180.0;
            double dLon = (place.Longitude.Value - selectedHotel.Longitude.Value) * Math.PI / 180.0;
            double lat1 = selectedHotel.Latitude.Value * Math.PI / 180.0;
            double lat2 = place.Latitude.Value * Math.PI / 180.0;

            double a = Math.Sin(dLat / 2) * Math.Sin(dLat / 2) +
                       Math.Cos(lat1) * Math.Cos(lat2) *
                       Math.Sin(dLon / 2) * Math.Sin(dLon / 2);
            double c = 2 * Math.Atan2(Math.Sqrt(a), Math.Sqrt(1 - a));
            int distMeters = (int)Math.Round(6371000 * c);

            int walkMins = Math.Max(1, (int)Math.Round(distMeters / 80.0));
            int driveMins = Math.Max(1, (int)Math.Round(distMeters / 550.0));

            return (distMeters, walkMins, driveMins);
        }

        // Fallback to static distance
        int fallbackWalk = place.WalkingTimeMinutes > 0 ? place.WalkingTimeMinutes : Math.Max(1, place.DistanceMeters / 80);
        int fallbackDrive = Math.Max(1, place.DistanceMeters / 550);
        return (place.DistanceMeters, fallbackWalk, fallbackDrive);
    }

    void ApplyFilters()
    {
        var q = allPlaces.AsEnumerable();

        if (selectedHotelId.HasValue && selectedHotelId.Value > 0)
        {
            q = q.Where(p => p.HotelId == selectedHotelId.Value);
            allNearSelectedCount = allPlaces.Count(p => p.HotelId == selectedHotelId.Value);
        }
        else
        {
            allNearSelectedCount = allPlaces.Count;
        }

        if (currentCat != "All")
            q = q.Where(p => p.Category == currentCat);

        if (activitySubcat != "All" && (currentCat == "Activity" || currentCat == "All"))
        {
            q = activitySubcat switch
            {
                "Sea" => q.Where(p => p.SubCategory.Contains("Tekne") || p.SubCategory.Contains("Su Spor") || p.SubCategory.Contains("Dalış") || p.SubCategory.Contains("Sörf") || p.SubCategory.Contains("SUP") || p.SubCategory.Contains("Kano") || p.SubCategory.Contains("Yüzme") || p.SubCategory.Contains("Deniz")),
                "Nature" => q.Where(p => p.SubCategory.Contains("Balon") || p.SubCategory.Contains("Safari") || p.SubCategory.Contains("Rafting") || p.SubCategory.Contains("Doğa") || p.SubCategory.Contains("Teleferik") || p.SubCategory.Contains("Atlı") || p.SubCategory.Contains("Adrenalin") || p.SubCategory.Contains("Kanyon") || p.SubCategory.Contains("Dağ")),
                "Culture" => q.Where(p => p.SubCategory.Contains("Tarih") || p.SubCategory.Contains("Kültür") || p.SubCategory.Contains("Müze") || p.SubCategory.Contains("Saray") || p.SubCategory.Contains("Arkeoloji") || p.SubCategory.Contains("Yeraltı") || p.SubCategory.Contains("Sanat") || p.SubCategory.Contains("Şehir") || p.SubCategory.Contains("Kale") || p.SubCategory.Contains("Çömlek")),
                "Spa" => q.Where(p => p.SubCategory.Contains("Hamam") || p.SubCategory.Contains("Spa") || p.SubCategory.Contains("Termal") || p.SubCategory.Contains("Çamur")),
                _ => q
            };
        }

        if (onlyPartners)
            q = q.Where(p => p.IsPartner);

        if (priceFilter > 0)
            q = q.Where(p => p.PriceLevel == priceFilter);

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var s = searchTerm.Trim().ToLower();
            q = q.Where(p =>
                p.Name.ToLower().Contains(s) ||
                p.SubCategory.ToLower().Contains(s) ||
                p.Description.ToLower().Contains(s) ||
                (p.Specialties != null && p.Specialties.ToLower().Contains(s)) ||
                (p.HighlightFeatures != null && p.HighlightFeatures.ToLower().Contains(s)) ||
                (p.Hotel != null && p.Hotel.City.ToLower().Contains(s)));
        }

        // Seçili otele olan gerçek mesafeye göre sırala
        var list = q.Select(p => new { Place = p, Dist = GetCalculatedDistance(p) });

        if (distFilter > 0)
        {
            list = list.Where(x => x.Dist.meters <= distFilter);
        }

        filteredPlaces = list.OrderBy(x => x.Dist.meters).ThenByDescending(x => x.Place.Rating).Select(x => x.Place).ToList();
    }

    void ResetFilters()
    {
        currentCat = "Activity";
        activitySubcat = "All";
        distFilter = 0;
        priceFilter = 0;
        onlyPartners = false;
        searchTerm = "";
        ApplyFilters();
        _ = SyncMapAsync();
    }

