@page "/nearby"
@layout Otel.Web.Components.Layout.PublicLayout
@inject NearbyService NearbySvc
@inject IDbContextFactory<AppDb> DbFactory
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="nearby-public-container">
    <div class="nearby-hero">
        <div class="nearby-hero-info">
            <div class="hero-tag-chip">🗺️ @(L.Lang == "tr" ? "TÜRKİYE'NİN SEÇKİN DESTİNASYONLARI & AKTİVİTELERİ" : "HANDPICKED LUXURY DESTINATIONS & EXPERIENCES")</div>
            <h1><span>✨</span> @(L.Lang == "tr" ? "Lüks Otel Koleksiyonumuz & Çevre Rehberi" : "Luxury Hotel Collection & Experiences")</h1>
            <p>
                @(selectedHotel != null
                    ? (L.Lang == "tr"
                        ? $"{selectedHotel.Name} ({selectedHotel.City}) tesisimize en yakın barlar, seçkin restoranlar ve yapılacak aktiviteler. Mesafeler seçtiğiniz otele göre anlık hesaplanmaktadır."
                        : $"Showing curated places and activities closest to {selectedHotel.Name} ({selectedHotel.City}). Distances are dynamically calculated from this hotel.")
                    : (L.Lang == "tr"
                        ? "Bodrum'un turkuaz koylarından Boğaziçi'ne, Kapadokya vadilerinden Uludağ karlı zirvelerine ve Mardin'in tarihi taş konaklarına kadar 8 seçkin tesisimiz ve çevre aktiviteleri."
                        : "From the Aegean turquoise coves to Cappadocia valleys, Uludağ ski peaks and Mardin historical stone palaces: explore our 8 signature destinations and activities."))
            </p>
        </div>
        <div class="nearby-hero-actions">
            <a href="/book@(selectedHotelId.HasValue ? $"?hotelId={selectedHotelId.Value}" : "")" class="btn primary hero-book-btn">
                🛎️ @(L.Lang == "tr" ? "Hemen Rezervasyon Yap" : "Book Room Now")
            </a>
            <a href="/trip-planner@(selectedHotelId.HasValue ? $"?hotelId={selectedHotelId.Value}" : "")" class="btn" style="background:linear-gradient(135deg, #6366f1, #8b5cf6);border:none;color:#fff;font-weight:700">
                🗺️ @(L.Lang == "tr" ? "AI Kişisel Rota Oluşturucu" : "AI Trip Planner")
            </a>
            <button class="btn" @onclick="OpenConciergeModal">💬 @(L.Lang == "tr" ? "AI Concierge Önerisi" : "AI Concierge")</button>
            <button class="btn ghost-btn" @onclick="OpenAddPlaceModal" title="Yeni Mekan / Aktivite Ekle">＋ @(L.Lang == "tr" ? "Mekan Ekle" : "Add Place")</button>
        </div>
    </div>

    <!-- 🌟 Lüks Otel Koleksiyonu Vitrini (8 Otel Görsel Kartları) -->
    <div class="luxury-showcase-section">
        <div class="showcase-header">
            <div>
                <div class="showcase-kicker">👑 8 SEÇKİN DESTİNASYONDA BENZERSİZ DENEYİMLER</div>
                <h2 class="showcase-title">@(L.Lang == "tr" ? "Otel Portföyümüzü Keşfedin" : "Explore Our Hotel Portfolio")</h2>
                <p class="showcase-desc">
                    @(L.Lang == "tr"
                        ? "Aşağıdaki tesis kartlarından dilediğinizi seçerek yakın çevresindeki turları, gurme restoranları ve barları inceleyebilir ya da doğrudan komisyonsuz rezervasyon yapabilirsiniz."
                        : "Select any property below to view nearby activities, fine dining, or book directly.")
                </p>
            </div>
            <div class="showcase-stats-tag">
                <span>✨ @hotels.Count @(L.Lang == "tr" ? "Özel Destinasyon" : "Properties")</span>
                <span>⭐ @(L.Lang == "tr" ? "%100 Doğrudan Rezervasyon" : "Direct Booking")</span>
            </div>
        </div>

        <div class="hotel-cards-grid">
            @foreach (var h in hotels)
            {
                var isSelected = selectedHotelId == h.Id;
                var hotelImg = !string.IsNullOrEmpty(h.ImageUrl) ? h.ImageUrl : "/hero.jpg";
                <div class="luxury-hotel-card @(isSelected ? "selected" : "")">
                    <div class="hotel-card-media" style="background-image: url('@hotelImg')">
                        <div class="hotel-media-overlay"></div>
                        <div class="hotel-city-chip">
                            @if (h.City.Contains("Bodrum")) { <span>🌊 Bodrum / Muğla</span> }
                            else if (h.City.Contains("İstanbul")) { <span>🕌 Beşiktaş / İstanbul</span> }
                            else if (h.City.Contains("Antalya")) { <span>🌴 Lara / Antalya</span> }
                            else if (h.City.Contains("Kapadokya") || h.City.Contains("Nevşehir")) { <span>🎈 Göreme / Kapadokya</span> }
                            else if (h.City.Contains("Çeşme") || h.City.Contains("İzmir")) { <span>⛵ Alaçatı / Çeşme</span> }
                            else if (h.City.Contains("Uludağ") || h.City.Contains("Bursa")) { <span>🎿 Uludağ / Bursa</span> }
                            else if (h.City.Contains("Fethiye")) { <span>🪂 Ölüdeniz / Fethiye</span> }
                            else if (h.City.Contains("Mardin")) { <span>🏛️ Artuklu / Mardin</span> }
                            else { <span>📍 @h.City</span> }
                        </div>
                        <div class="hotel-stars-pill">
                            @string.Concat(Enumerable.Repeat("★", h.Stars)) 5★
                        </div>
                    </div>

                    <div class="hotel-card-body">
                        <h3 class="hotel-title">@h.Name</h3>
                        <p class="hotel-concept">
                            @if (h.City.Contains("Uludağ")) { <span>Kış Sporları, Telesiyej Erişimi & Şifalı Termal Spa</span> }
                            else if (h.City.Contains("Fethiye")) { <span>Ölüdeniz Lagün Manzarası & Müstakil Havuzlu Villalar</span> }
                            else if (h.City.Contains("Mardin")) { <span>600 Yıllık Tarihi Taş Konak & Sonsuz Mezopotamya Manzarası</span> }
                            else if (h.City.Contains("İstanbul")) { <span>Tarihi Boğaziçi Yalı Hattı & Saray Panoraması</span> }
                            else if (h.City.Contains("Kapadokya")) { <span>Doğal Kaya Oyma Cave Süitler & Balon Seyir Terası</span> }
                            else if (h.City.Contains("Çeşme")) { <span>Tarihi Alaçatı Taş Mimarisi & Marina Yat Limanı</span> }
                            else if (h.City.Contains("Antalya")) { <span>Ultra Her Şey Dahil Akdeniz Sahili & Özel Plaj</span> }
                            else { <span>Ege'nin Turkuaz Koyları, Özel Marinalı Lüks Resort</span> }
                        </p>

                        <div class="hotel-card-actions">
                            <button class="btn-explore-hotel @(isSelected ? "active" : "")" @onclick="() => SelectHotel(h.Id)">
                                📍 @(isSelected ? (L.Lang == "tr" ? "Seçili Tesis" : "Selected") : (L.Lang == "tr" ? "Çevreyi Gör" : "Explore Nearby"))
                            </button>
                            <a href="/book?hotelId=@h.Id" class="btn-book-hotel">
                                🛎️ @(L.Lang == "tr" ? "Rezervasyon" : "Book")
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

<!-- Çoklu Otel Seçici Çubuğu -->
<div class="hotel-selector-bar">
    <button class="hotel-pill-btn @(selectedHotelId == null ? "active" : "")" @onclick="() => SelectHotel(null)">
        <span>🌐</span>
        <span>@(L.Lang == "tr" ? "Tüm Oteller" : "All Hotels")</span>
        <span class="hotel-city-badge">@hotels.Count @(L.Lang == "tr" ? "Tesis" : "Props")</span>
    </button>
    @foreach (var h in hotels)
    {
        <button class="hotel-pill-btn @(selectedHotelId == h.Id ? "active" : "")" @onclick="() => SelectHotel(h.Id)">
            <span>🏨</span>
            <span>@h.Name</span>
            <span class="hotel-city-badge">@h.City</span>
        </button>
    }
</div>

<!-- Seçili Otel Bilgi & Hızlı Filtre Paneli -->
@if (selectedHotel != null)
{
    <div class="hotel-banner-card">
        <div style="display:flex;align-items:center;gap:16px">
            <div style="width:52px;height:52px;border-radius:14px;background:var(--grad);display:grid;place-items:center;font-size:26px;box-shadow:0 6px 20px -4px hsla(172,80%,50%,.6)">🏨</div>
            <div>
                <div class="hotel-banner-badge">📍 SEÇİLİ TESİS & YAKIN ÇEVRESİ</div>
                <div style="display:flex;align-items:center;gap:10px">
                    <h2 style="margin:0;font-size:1.35rem;font-weight:700">@selectedHotel.Name</h2>
                    <span style="color:#ffd159;font-size:.9rem">@string.Concat(Enumerable.Repeat("★", selectedHotel.Stars))</span>
                </div>
                <div class="muted" style="font-size:.86rem;margin-top:3px">
                    <span>📍 @selectedHotel.Address, @selectedHotel.City</span>
                    @if (!string.IsNullOrEmpty(selectedHotel.Phone))
                    {
                        <span> • 📞 @selectedHotel.Phone</span>
                    }
                </div>
            </div>
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
            <a href="/book?hotelId=@selectedHotel.Id" class="btn sm" style="background:linear-gradient(135deg,#0ea5e9,#38bdf8);border:none;color:#fff;font-weight:700;display:inline-flex;align-items:center;gap:6px">
                🛎️ @(L.Lang == "tr" ? "Bu Otele Rezervasyon Yap" : "Book This Hotel")
            </a>
            <button class="btn sm @(currentCat == "All" ? "primary" : "")" @onclick='() => SetCategory("All")'>
                ✨ @(L.Lang == "tr" ? "Otele Yakın Tümü" : "All Nearby") (@allNearSelectedCount)
            </button>
            <button class="btn sm @(currentCat == "Activity" ? "primary" : "")" @onclick='() => SetCategory("Activity")'>
                🏄‍♂️ @(L.Lang == "tr" ? "Aktiviteler" : "Activities") (@(stats?.ActivitiesCount ?? 0))
            </button>
            <button class="btn sm @(currentCat == "Restaurant" ? "primary" : "")" @onclick='() => SetCategory("Restaurant")'>
                🍽️ @(L.Lang == "tr" ? "Restoranlar" : "Restaurants") (@(stats?.RestaurantsCount ?? 0))
            </button>
            <button class="btn sm @(currentCat == "Bar" ? "primary" : "")" @onclick='() => SetCategory("Bar")'>
                🍸 @(L.Lang == "tr" ? "Barlar" : "Bars") (@(stats?.BarsCount ?? 0))
            </button>
            @if (selectedHotel.Latitude.HasValue && selectedHotel.Longitude.HasValue)
            {
                <button class="btn sm" @onclick="() => FocusHotelOnMap(selectedHotel)">
                    🗺️ @(L.Lang == "tr" ? "Haritada Odaklan" : "Focus Map")
                </button>
            }
        </div>
    </div>
}

<!-- İnteraktif Leaflet Haritası -->
@if (mapViewMode != "only-list")
{
    <div class="map-card-wrapper">
        <div class="map-view-controls">
            <button class="map-view-btn @(mapViewMode == "split" ? "active" : "")" @onclick='() => SetMapMode("split")'>
                🗺️ @(L.Lang == "tr" ? "Harita & Liste" : "Map & List")
            </button>
            <button class="map-view-btn @(mapViewMode == "large" ? "active" : "")" @onclick='() => SetMapMode("large")'>
                🔍 @(L.Lang == "tr" ? "Geniş Harita" : "Large Map")
            </button>
            <button class="map-view-btn" @onclick='() => SetMapMode("only-list")'>
                ✕ @(L.Lang == "tr" ? "Haritayı Gizle" : "Hide Map")
            </button>
        </div>

        <div id="nearbyMap" style="height:@(mapViewMode == "large" ? "620px" : "430px"); width:100%; transition:height .3s ease;"></div>

        <div class="map-legend-bar">
            <span class="muted" style="font-weight:600;font-size:.74rem">HARİTA GÖSTERGESİ:</span>
            <span class="map-legend-item"><span class="map-legend-dot dot-hotel"></span> 🏨 Otel Noktaları (@hotels.Count)</span>
            <span class="map-legend-item"><span class="map-legend-dot dot-act"></span> 🏄‍♂️ Turlar & Aktiviteler (@(stats?.ActivitiesCount ?? 0))</span>
            <span class="map-legend-item"><span class="map-legend-dot dot-rest"></span> 🍽️ Restoranlar (@(stats?.RestaurantsCount ?? 0))</span>
            <span class="map-legend-item"><span class="map-legend-dot dot-bar"></span> 🍸 Barlar & Gece (@(stats?.BarsCount ?? 0))</span>
            <span class="sp"></span>
            <span class="muted" style="font-size:.76rem">💡 Haritadaki işaretçilere tıklayarak detay ve yol tarifini inceleyebilirsiniz.</span>
        </div>
    </div>
}
else
{
    <div style="margin-bottom:18px">
        <button class="btn sm" @onclick='() => SetMapMode("split")'>🗺️ @(L.Lang == "tr" ? "İnteraktif Haritayı Göster" : "Show Interactive Map")</button>
    </div>
}

<!-- KPI İstatistik Kartları -->
@if (stats != null)
{
    <div class="grid g4 mb">
        <div class="card kpi" style="cursor:pointer" @onclick='() => SetCategory("Activity")'>
            <span class="ico">🏄‍♂️</span>
            <div class="label">@(L.Lang == "tr" ? "Turlar & Aktiviteler" : "Tours & Activities")</div>
            <div class="val">@stats.ActivitiesCount</div>
            <div class="sub">@(selectedHotel != null ? selectedHotel.City : "Tüm Tesisler")</div>
        </div>
        <div class="card kpi" style="cursor:pointer" @onclick='() => SetCategory("Restaurant")'>
            <span class="ico">🍽️</span>
            <div class="label">@(L.Lang == "tr" ? "Seçkin Restoranlar" : "Fine Restaurants")</div>
            <div class="val">@stats.RestaurantsCount</div>
            <div class="sub">@(selectedHotel != null ? selectedHotel.City : "Tüm Tesisler")</div>
        </div>
        <div class="card kpi" style="cursor:pointer" @onclick='() => SetCategory("Bar")'>
            <span class="ico">🍸</span>
            <div class="label">@(L.Lang == "tr" ? "Barlar & Gece Hayatı" : "Bars & Nightlife")</div>
            <div class="val">@stats.BarsCount</div>
            <div class="sub">@(selectedHotel != null ? selectedHotel.City : "Tüm Tesisler")</div>
        </div>
        <div class="card kpi" style="cursor:pointer" @onclick="TogglePartners">
            <span class="ico">🎁</span>
            <div class="label">@(L.Lang == "tr" ? "Otel İndirimli" : "Partner Discounts")</div>
            <div class="val">@stats.PartnersCount</div>
            <div class="sub">@(L.Lang == "tr" ? "Anlaşmalı VIP noktalar" : "Exclusive perks")</div>
        </div>
    </div>
}

<!-- Filtre Paneli -->
<div class="nearby-filter-panel">
    <div class="nearby-cat-pills">
        <button class="nearby-cat-btn @(currentCat == "All" ? "active" : "")" @onclick='() => SetCategory("All")'>
            <span>✨</span> @(L.Lang == "tr" ? "Tümü" : "All") (@filteredPlaces.Count)
        </button>
        <button class="nearby-cat-btn @(currentCat == "Activity" ? "active" : "")" @onclick='() => SetCategory("Activity")'>
            <span>🏄‍♂️</span> @(L.Lang == "tr" ? "Aktiviteler & Turlar" : "Activities") (@(stats?.ActivitiesCount ?? 0))
        </button>
        <button class="nearby-cat-btn @(currentCat == "Restaurant" ? "active" : "")" @onclick='() => SetCategory("Restaurant")'>
            <span>🍽️</span> @(L.Lang == "tr" ? "Restoranlar" : "Restaurants") (@(stats?.RestaurantsCount ?? 0))
        </button>
        <button class="nearby-cat-btn @(currentCat == "Bar" ? "active" : "")" @onclick='() => SetCategory("Bar")'>
            <span>🍸</span> @(L.Lang == "tr" ? "Barlar" : "Bars") (@(stats?.BarsCount ?? 0))
        </button>
    </div>

    <div class="nearby-subfilters">
        <div class="nearby-toggle-partner @(onlyPartners ? "on" : "")" @onclick="TogglePartners">
            <span>🎁</span> @(L.Lang == "tr" ? "Sadece Otel İndirimli" : "Discounts Only")
        </div>

        <select style="width:auto;min-width:140px" @bind="distFilter" @bind:after="ApplyFilters">
            <option value="0">@(L.Lang == "tr" ? "Tüm Mesafeler" : "All Distances")</option>
            <option value="1200">🚶 @(L.Lang == "tr" ? "< 1.2 km (Yürüme)" : "< 1.2 km")</option>
            <option value="5000">🚗 @(L.Lang == "tr" ? "< 5 km (Yakın Araç)" : "< 5 km")</option>
            <option value="15000">🚘 @(L.Lang == "tr" ? "< 15 km" : "< 15 km")</option>
            <option value="70000">🗺️ @(L.Lang == "tr" ? "< 70 km (Bölgesel)" : "< 70 km")</option>
        </select>

        <select style="width:auto;min-width:130px" @bind="priceFilter" @bind:after="ApplyFilters">
            <option value="0">@(L.Lang == "tr" ? "Tüm Fiyatlar" : "All Prices")</option>
            <option value="1">₺ (Ekonomik)</option>
            <option value="2">₺₺ (Orta)</option>
            <option value="3">₺₺₺ (Seçkin)</option>
            <option value="4">₺₺₺₺ (Lüks)</option>
        </select>

        <input type="text" class="search" placeholder="@(L.Lang == "tr" ? "Mekan, aktivite veya tur ara..." : "Search place or tour...")"
               @bind="searchTerm" @bind:event="oninput" @bind:after="ApplyFilters" />
    </div>
</div>

@if (currentCat == "Activity" || currentCat == "All")
{
    <!-- Aktiviteler Tür Alt-Filtresi -->
    <div class="activity-subcat-bar">
        <span class="activity-subcat-title">🏄‍♂️ @(L.Lang == "tr" ? "Aktivite Türü:" : "Experience Type:")</span>
        <button class="activity-subcat-btn @(activitySubcat == "All" ? "active" : "")" @onclick='() => SetActivitySubcat("All")'>
            ✨ @(L.Lang == "tr" ? "Tüm Aktiviteler" : "All Activities")
        </button>
        <button class="activity-subcat-btn @(activitySubcat == "Sea" ? "active" : "")" @onclick='() => SetActivitySubcat("Sea")'>
            ⛵ @(L.Lang == "tr" ? "Su Sporları & Tekne" : "Water Sports & Yacht")
        </button>
        <button class="activity-subcat-btn @(activitySubcat == "Nature" ? "active" : "")" @onclick='() => SetActivitySubcat("Nature")'>
            🌄 @(L.Lang == "tr" ? "Doğa & Macera" : "Nature & Adventure")
        </button>
        <button class="activity-subcat-btn @(activitySubcat == "Culture" ? "active" : "")" @onclick='() => SetActivitySubcat("Culture")'>
            🏛️ @(L.Lang == "tr" ? "Tarih & Kültür" : "History & Culture")
        </button>
        <button class="activity-subcat-btn @(activitySubcat == "Spa" ? "active" : "")" @onclick='() => SetActivitySubcat("Spa")'>
            🧖 @(L.Lang == "tr" ? "Hamam & Spa" : "Hammam & Spa")
        </button>
    </div>
}

<!-- Kartlar Listesi -->
@if (loading)
{
    <div style="text-align:center;padding:40px" class="muted">⏳ @(L.Lang == "tr" ? "Mekanlar ve harita yükleniyor..." : "Loading places...")</div>
}
else if (filteredPlaces.Count == 0)
{
    <div class="card" style="text-align:center;padding:60px 20px">
        <div style="font-size:3rem;margin-bottom:12px">🏝️</div>
        <h3>@(L.Lang == "tr" ? "Seçilen otele yakın kriterlere uygun yer bulunamadı" : "No places found for selected hotel")</h3>
        <p class="muted" style="margin-top:8px">@(L.Lang == "tr" ? "Filtreleri sıfırlayarak bu otele yakın tüm noktaları görebilirsiniz." : "Reset filters to view all nearby options.")</p>
        <button class="btn mt" @onclick="ResetFilters">↺ @(L.Lang == "tr" ? "Filtreleri Sıfırla" : "Reset Filters")</button>
    </div>
}
else
{
    <div class="nearby-grid">
        @foreach (var place in filteredPlaces)
        {
            var dist = GetCalculatedDistance(place);
            var isActivity = place.Category == "Activity";

            <div class="place-card" style="@(isActivity ? "border-color:hsla(185, 80%, 50%, .25)" : "")">
                <div class="place-img-wrap">
                    @if (!string.IsNullOrEmpty(place.ImageUrl))
                    {
                        <img src="@place.ImageUrl" alt="@place.Name" class="place-img" />
                    }
                    else
                    {
                        <div class="place-img" style="background:var(--grad);opacity:.2"></div>
                    }
                    <div class="place-img-overlay"></div>
                    <div class="place-top-badges">
                        <span class="place-badge-type" style="@(isActivity ? "background:linear-gradient(135deg, hsla(185,90%,35%,.85), hsla(210,90%,30%,.85));border-color:hsla(185,90%,60%,.4)" : "")">
                            @(place.Category switch
                            {
                                "Bar" => "🍸 Bar & Gece",
                                "Restaurant" => "🍽️ Restoran",
                                "Activity" => "🏄‍♂️ Aktivite & Tur",
                                _ => place.Category
                            })
                        </span>
                        <span class="place-badge-rating">
                            ★ @place.Rating.ToString("0.0") <small style="color:var(--muted);font-weight:400">(@place.ReviewCount)</small>
                        </span>
                    </div>

                    <!-- Kart Üzerinde Belirgin Otele Yakınlık Rozeti -->
                    <div class="place-proximity-tag @(dist.meters <= 1200 ? "walk" : dist.meters <= 8000 ? "drive" : "tour")">
                        @if (dist.meters <= 1200)
                        {
                            <span>🚶 <b>@dist.meters m</b> @(selectedHotel != null ? selectedHotel.Name + "'e" : "otele") (@dist.walk dk yürüme)</span>
                        }
                        else if (dist.meters <= 8000)
                        {
                            <span>🚗 <b>@((dist.meters / 1000.0).ToString("0.#")) km</b> @(selectedHotel != null ? selectedHotel.Name + "'e" : "otele") (@dist.drive dk araç)</span>
                        }
                        else
                        {
                            <span>🚘 <b>@((dist.meters / 1000.0).ToString("0.#")) km</b> @(selectedHotel != null ? selectedHotel.Name + "'e" : "otele") (@dist.drive dk transfer)</span>
                        }
                    </div>
                </div>

                <div class="place-body">
                    <div class="place-head-row">
                        <div class="place-name">@place.Name</div>
                        <div class="place-price-level">@GetPriceSymbols(place.PriceLevel)</div>
                    </div>

                    <div class="place-subcat">
                        @place.SubCategory
                        @if (selectedHotelId == null && place.Hotel != null)
                        {
                            <span style="color:var(--accent);font-weight:600"> • 🏨 @place.Hotel.City</span>
                        }
                    </div>

                    @if (place.IsPartner && !string.IsNullOrEmpty(place.HotelDiscountNote))
                    {
                        <div class="place-partner-banner">
                            <span>🎁</span>
                            <span>@place.HotelDiscountNote</span>
                        </div>
                    }

                    <!-- Otele Yakınlık Bilgisi (Dinamik Haversine Mesafe) -->
                    <div class="place-meta-list" style="background:hsla(220,40%,80%,.04);padding:8px 12px;border-radius:10px;margin-bottom:12px">
                        <span class="place-meta-item" style="color:var(--accent);font-weight:600">
                            <span>📍</span> @(dist.meters < 1000 ? $"{dist.meters}m" : $"{(dist.meters / 1000.0):0.#} km")
                            @(selectedHotel != null ? "otele" : "")
                        </span>
                        @if (dist.meters <= 1200)
                        {
                            <span class="place-meta-item" style="color:var(--ok)">
                                <span>🚶</span> @dist.walk dk @(L.Lang == "tr" ? "yürüme" : "walk")
                            </span>
                        }
                        else
                        {
                            <span class="place-meta-item" style="color:var(--info)">
                                <span>🚗</span> @dist.drive dk @(L.Lang == "tr" ? "araç / servis" : "drive")
                            </span>
                        }
                        <span class="place-meta-item">
                            <span>🕒</span> @place.WorkingHours
                        </span>
                    </div>

                    <div class="place-desc">
                        @(L.Lang == "en" && !string.IsNullOrEmpty(place.DescriptionEn) ? place.DescriptionEn : place.Description)
                    </div>

                    @if (!string.IsNullOrEmpty(place.Specialties))
                    {
                        <div class="place-specialty-box" style="@(isActivity ? "border-left-color:hsl(185, 90%, 50%)" : "")">
                            <b>@(isActivity ? (L.Lang == "tr" ? "Öne Çıkan Rota & Deneyim: " : "Route & Experience: ") : (L.Lang == "tr" ? "Öne Çıkanlar: " : "Highlights: "))</b>@place.Specialties
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(place.HighlightFeatures))
                    {
                        <div class="place-tags-row">
                            @foreach (var tag in place.HighlightFeatures.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).Take(4))
                            {
                                <span class="place-pill-tag">#@tag</span>
                            }
                        </div>
                    }

                    <div class="place-actions">
                        <button class="btn sm" @onclick="() => ShowDetail(place)">
                            🔍 @(L.Lang == "tr" ? "Detaylar" : "Details")
                        </button>
                        <button class="btn sm" @onclick="() => FocusOnMap(place)">
                            🗺️ @(L.Lang == "tr" ? "Haritada Gör" : "On Map")
                        </button>
                        <button class="btn sm" @onclick="() => RecommendPlace(place)">
                            💬 @(L.Lang == "tr" ? "Öner" : "Recommend")
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

