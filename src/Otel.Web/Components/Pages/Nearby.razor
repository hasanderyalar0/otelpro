        ImageUrl = "/hero.jpg"
    };
    string hotelFormError = "";

    DotNetObjectReference<Nearby>? dotNetRef;
    bool mapInitialized = false;

    protected override async Task OnInitializedAsync()
    {
        dotNetRef = DotNetObjectReference.Create(this);
        await LoadDataAsync();
        await LoadInHouseGuestsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !mapInitialized && mapViewMode != "only-list")
        {
            await Task.Delay(300);
            await InitializeMapAsync();
        }
    }

    async Task LoadDataAsync()
    {
        loading = true;
        try
        {
            hotels = await NearbySvc.GetHotelsAsync();
            if (CurrentHotelState.SelectedHotelId > 0 && hotels.Any(h => h.Id == CurrentHotelState.SelectedHotelId))
            {
                selectedHotelId = CurrentHotelState.SelectedHotelId;
                selectedHotel = hotels.FirstOrDefault(h => h.Id == CurrentHotelState.SelectedHotelId);
            }
            else if (hotels.Count > 0 && selectedHotelId == null)
            {
                selectedHotelId = hotels[0].Id;
                selectedHotel = hotels[0];
            }

            allPlaces = await NearbySvc.GetAllAsync();
            stats = await NearbySvc.GetStatsAsync(selectedHotelId);
            ApplyFilters();

            if (mapInitialized)
            {
                await SyncMapAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading nearby: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }

    async Task InitializeMapAsync()
    {
        try
        {
            double lat = selectedHotel?.Latitude ?? 39.0;
            double lng = selectedHotel?.Longitude ?? 35.0;
            int zoom = selectedHotel != null ? 13 : 6;

            await JS.InvokeVoidAsync("initLeafletMap", "nearbyMap", dotNetRef, lat, lng, zoom);
            mapInitialized = true;
            await SyncMapAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Map init error: {ex.Message}");
        }
    }

    async Task SyncMapAsync()
    {
        if (!mapInitialized || mapViewMode == "only-list") return;
        try
        {
            var mapHotels = hotels.Select(h => new
            {
                id = h.Id,
                name = h.Name,
                city = h.City,
                address = h.Address,
                stars = h.Stars,
                latitude = h.Latitude,
                longitude = h.Longitude
            }).ToList();

            var mapPlaces = filteredPlaces.Select(p => new
            {
                id = p.Id,
                name = p.Name,
                category = p.Category,
                subCategory = p.SubCategory,
                rating = p.Rating,
                priceLevel = p.PriceLevel,
                distanceMeters = GetCalculatedDistance(p).meters,
                isPartner = p.IsPartner,
                imageUrl = p.ImageUrl,
                latitude = p.Latitude,
                longitude = p.Longitude
            }).ToList();

            await JS.InvokeVoidAsync("updateMapData", mapHotels, mapPlaces, selectedHotelId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Map sync error: {ex.Message}");
        }
    }

    async Task SelectHotel(int? hotelId)
    {
        selectedHotelId = hotelId;
        selectedHotel = hotels.FirstOrDefault(h => h.Id == hotelId);
        if (hotelId.HasValue)
        {
            await CurrentHotelState.SetHotelAsync(hotelId.Value);
        }
        stats = await NearbySvc.GetStatsAsync(selectedHotelId);
        ApplyFilters();
        await SyncMapAsync();
        await LoadInHouseGuestsAsync();
    }

