            <div style="display:flex;gap:10px;justify-content:space-between;align-items:center;margin-top:18px">
                <div>
                    @if (copiedToast)
                    {
                        <span style="color:var(--ok);font-size:.85rem;font-weight:600">✓ @(L.Lang == "tr" ? "Mesaj panoya kopyalandı!" : "Copied to clipboard!")</span>
