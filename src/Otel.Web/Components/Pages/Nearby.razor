            await JS.InvokeVoidAsync("navigator.clipboard.writeText", conciergeGeneratedText);
            copiedToast = true;
            StateHasChanged();
            await Task.Delay(2500);
            copiedToast = false;
            StateHasChanged();
        }
        catch
        {
            // fallback
        }
    }

    string GetWhatsAppUrl()
    {
        string text = Uri.EscapeDataString(conciergeGeneratedText);
        string phoneClean = new string(guestPhone.Where(char.IsDigit).ToArray());
        return string.IsNullOrEmpty(phoneClean) ? $"https://wa.me/?text={text}" : $"https://wa.me/{phoneClean}?text={text}";
    }

