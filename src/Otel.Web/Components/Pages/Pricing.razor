@code {
    int roomCount = 20;
    bool isAnnual = true;
    bool showDemoModal = false;
    bool demoSuccess = false;

    string demoHotelName = "";
    string demoContactName = "";
    string demoPhone = "";
    string demoCity = "";
    string demoEmail = "";

    void SetRoomPreset(int rooms)
    {
        roomCount = rooms;
    }

    string GetTierName(int rooms) => rooms switch
    {
        <= 10 => "Butik & Pansiyon",
        <= 25 => "Orta Ölçek Tesis",
        <= 50 => "Resort & Tatil Köyü",
        <= 100 => "Büyük Tesis",
        _ => "Zincir & Grup Otel"
    };

    decimal GetCalculatedPriceTl()
    {
        // 1-10 oda: 2990 TL/ay
        // 11-25 oda: 3890 TL/ay
        // 26-50 oda: 4690 TL/ay
        // 51-100 oda: 6490 TL/ay
        // 100+ oda: 8490 TL + her ekstra 20 oda için 500 TL
        decimal baseMonthly = roomCount switch
        {
            <= 10 => 2990m,
            <= 25 => 3890m,
            <= 50 => 4690m,
            <= 100 => 6490m,
            _ => 8490m + ((roomCount - 100) / 20) * 500m
        };

        if (isAnnual)
        {
            // %17 indirim (2 ay hediye)
            return Math.Round(baseMonthly * 0.833m);
        }
        return baseMonthly;
    }

    int GetCalculatedPriceEur()
    {
        decimal tl = GetCalculatedPriceTl();
        return (int)Math.Round(tl / 34m); // yaklaşık kur
    }

    decimal GetAnnualSavingsTl()
    {
        decimal monthlyPrice = roomCount switch
        {
            <= 10 => 2990m,
            <= 25 => 3890m,
            <= 50 => 4690m,
            <= 100 => 6490m,
            _ => 8490m + ((roomCount - 100) / 20) * 500m
        };
        // 2 aylık tasarruf
        return monthlyPrice * 2;
    }

    void OpenDemoModal()
    {
        showDemoModal = true;
        demoSuccess = false;
    }

    void SubmitDemoRequest()
    {
        if (string.IsNullOrWhiteSpace(demoHotelName)) demoHotelName = "Örnek Butik Otel";
        if (string.IsNullOrWhiteSpace(demoPhone)) demoPhone = "+90 532 123 45 67";
        demoSuccess = true;
    }
}
