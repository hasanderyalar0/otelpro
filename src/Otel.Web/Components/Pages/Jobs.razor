@code {
    string activeTab = "jobs"; // "jobs", "applications", "cv"
    JobRoleCategory? selectedCategory = null;
    string selectedCity = "";
    string searchQuery = "";
    bool onlyWithAccommodation = false;

    List<JobPosting> postings = new();
    List<JobApplication> applications = new();
    List<JobCandidatePool> candidates = new();

    // Başvuru Modalı
    bool showApplyModal = false;
    bool applySuccess = false;
    JobPosting? selectedJob = null;
    string applyName = "";
    string applyPhone = "";
    string applyCity = "";
    string applyExp = "1 Sezon";
    string applyLojman = "true";
    string applyNotes = "";

    // Yeni İlan Modalı
    bool showNewJobModal = false;
    string newJobTitle = "";
    JobRoleCategory newJobCategory = JobRoleCategory.Waiter;
    string newJobCity = "Bodrum / Muğla";
    string newJobSalary = "34.000 ₺ - 42.000 ₺ + Tip";
    string newJobWorkType = "Sezonluk (Mayıs - Ekim)";
    bool newJobLojman = true;
    bool newJobMeals = true;
    string newJobDesc = "";
    string newJobPhone = "+90 252 555 01 10";

    // CV Bırakma Formu
    JobCandidatePool newCand = new() { PreferredRole = "Garson", ExperienceYears = "1 Yıl", NeedsAccommodation = true, ReadyImmediate = true };
    bool candidateSubmitted = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    async Task LoadDataAsync()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        postings = await db.JobPostings.Include(j => j.Hotel).OrderByDescending(j => j.CreatedAt).ToListAsync();
        applications = await db.JobApplications.Include(a => a.JobPosting).OrderByDescending(a => a.AppliedAt).ToListAsync();
        candidates = await db.JobCandidates.OrderByDescending(c => c.CreatedAt).ToListAsync();
    }

    List<JobPosting> filteredPostings => postings
        .Where(p => selectedCategory == null || p.Category == selectedCategory)
        .Where(p => string.IsNullOrWhiteSpace(selectedCity) || p.City.Contains(selectedCity))
        .Where(p => !onlyWithAccommodation || p.AccommodationProvided)
        .Where(p => string.IsNullOrWhiteSpace(searchQuery) ||
                    p.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    p.PositionName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    p.City.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    (p.Hotel != null && p.Hotel.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)))
        .ToList();

    void ClearFilters()
    {
        selectedCategory = null;
        selectedCity = "";
        searchQuery = "";
        onlyWithAccommodation = false;
    }

    string GetRoleEmoji(JobRoleCategory cat) => cat switch
    {
        JobRoleCategory.Waiter => "🍽️",
        JobRoleCategory.Busboy => "盆",
        JobRoleCategory.Housekeeping => "🧹",
        JobRoleCategory.FrontDesk => "🛎️",
        JobRoleCategory.Kitchen => "👨‍🍳",
        JobRoleCategory.Bartender => "🍹",
        _ => "🏨"
    };

    string GetStatusClass(string st) => st switch
    {
        "Beklemede" => "st-beklemede",
        "Arandı" => "st-arandi",
        "Mülakat" => "st-mulakat",
        "Onaylandı" => "st-onay",
        _ => ""
    };

    void OpenApplyModal(JobPosting job)
    {
        selectedJob = job;
        applySuccess = false;
        showApplyModal = true;
    }

    async Task SubmitApplication()
    {
        if (selectedJob == null) return;
        if (string.IsNullOrWhiteSpace(applyName) || string.IsNullOrWhiteSpace(applyPhone)) return;

        using var db = await DbFactory.CreateDbContextAsync();
        var app = new JobApplication
        {
            JobPostingId = selectedJob.Id,
            FullName = applyName,
            Phone = applyPhone,
            CurrentCity = string.IsNullOrWhiteSpace(applyCity) ? selectedJob.City : applyCity,
            ExperienceYears = applyExp,
            RoleApplied = selectedJob.PositionName,
            NeedsAccommodation = applyLojman == "true",
            Notes = applyNotes,
            Status = "Beklemede",
            AppliedAt = DateTime.Now
        };
        db.JobApplications.Add(app);
        await db.SaveChangesAsync();

        applySuccess = true;
        await LoadDataAsync();
    }

    async Task UpdateAppStatus(JobApplication app, string newStatus)
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var dbApp = await db.JobApplications.FindAsync(app.Id);
        if (dbApp != null)
        {
            dbApp.Status = newStatus;
            await db.SaveChangesAsync();
            app.Status = newStatus;
        }
    }

    async Task SubmitCandidateProfile()
    {
        if (string.IsNullOrWhiteSpace(newCand.FullName) || string.IsNullOrWhiteSpace(newCand.Phone)) return;

        using var db = await DbFactory.CreateDbContextAsync();
        var cand = new JobCandidatePool
        {
            FullName = newCand.FullName,
            Phone = newCand.Phone,
            City = string.IsNullOrWhiteSpace(newCand.City) ? "Belirtilmedi" : newCand.City,
            PreferredRole = newCand.PreferredRole,
            ExperienceYears = newCand.ExperienceYears,
            NeedsAccommodation = newCand.NeedsAccommodation,
            ReadyImmediate = newCand.ReadyImmediate,
            Note = newCand.Note,
            CreatedAt = DateTime.Now
        };
        db.JobCandidates.Add(cand);
        await db.SaveChangesAsync();

        candidateSubmitted = true;
        newCand = new() { PreferredRole = "Garson", ExperienceYears = "1 Yıl", NeedsAccommodation = true, ReadyImmediate = true };
        await LoadDataAsync();
    }

    async Task SubmitNewJobPosting()
    {
        if (string.IsNullOrWhiteSpace(newJobTitle) || string.IsNullOrWhiteSpace(newJobPhone)) return;

        using var db = await DbFactory.CreateDbContextAsync();
        var hotel = await db.Hotels.FirstOrDefaultAsync();
        if (hotel == null) return;

        var job = new JobPosting
        {
            HotelId = hotel.Id,
            Title = newJobTitle,
            Category = newJobCategory,
            PositionName = newJobCategory switch
            {
                JobRoleCategory.Waiter => "Garson",
                JobRoleCategory.Busboy => "Komi",
                JobRoleCategory.Housekeeping => "Kat Hizmetleri / Temizlik",
                JobRoleCategory.FrontDesk => "Resepsiyonist",
                JobRoleCategory.Kitchen => "Aşçı",
                JobRoleCategory.Bartender => "Barmen",
                _ => "Personel"
            },
            City = newJobCity,
            SalaryRange = newJobSalary,
            WorkType = newJobWorkType,
            AccommodationProvided = newJobLojman,
            MealsIncluded = newJobMeals,
            Description = newJobDesc,
            Requirements = "İletişimi güçlü, ekip çalışmasına yatkın.",
            ContactPhone = newJobPhone,
            IsActive = true,
            CreatedAt = DateTime.Now
        };

        db.JobPostings.Add(job);
        await db.SaveChangesAsync();

        showNewJobModal = false;
        await LoadDataAsync();
    }
}
