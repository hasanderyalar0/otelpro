@page "/jobs"
@page "/kariyer"
@layout Otel.Web.Components.Layout.PublicLayout
@inject IDbContextFactory<AppDb> DbFactory
@inject AuthService Auth

<div class="jobs-page">
    <!-- Hero Bölümü -->
    <section class="jobs-hero">
        <div class="jobs-hero-badge">
            <span class="pulse-dot"></span> Turizm & Otelcilik Personel ve Kariyer Portalı
        </div>
        <h1>Oteller ve İş Arayanlar Tek Çatıda:<br/><span class="gradient-text">Garson, Komi ve Kat Hizmetleri İlanları</span></h1>
        <p class="hero-desc">
            Turizm sektöründeki oteller personel arıyor, çalışanlar en iyi lojmanlı ve maaşlı iş fırsatlarına doğrudan ulaşıyor. Aracısız, hızlı ve güvenilir başvuru.
        </p>

        <!-- Üst Hızlı İstatistikler & Butonlar -->
        <div class="hero-stats-row">
            <div class="stat-box">
                <span class="num">@postings.Count</span>
                <span class="lbl">Aktif Otel İlanı</span>
            </div>
            <div class="stat-box">
                <span class="num">@candidates.Count</span>
                <span class="lbl">Kayıtlı Aday Havuzu</span>
            </div>
            <div class="stat-box">
                <span class="num">@applications.Count</span>
                <span class="lbl">İncelenen Başvuru</span>
            </div>
            <div class="hero-actions">
                <button class="btn-post-job" @onclick="() => showNewJobModal = true">
                    ＋ Oteliniz İçin İlan Verin
                </button>
                <button class="btn-cv-pool" @onclick='() => activeTab = "cv"'>
                    📝 İş Arıyorum (CV Bırak)
                </button>
            </div>
        </div>
    </section>

    <!-- Sekmeler: İlanlar / Gelen Başvurular / CV Havuzu -->
    <div class="portal-nav-tabs">
        <button class="tab-btn @(activeTab == "jobs" ? "active" : "")" @onclick='() => activeTab = "jobs"'>
            💼 Açık Otel İlanları (@filteredPostings.Count)
        </button>
        <button class="tab-btn @(activeTab == "applications" ? "active" : "")" @onclick='() => activeTab = "applications"'>
            📥 Gelen Başvurular (@applications.Count)
        </button>
        <button class="tab-btn @(activeTab == "cv" ? "active" : "")" @onclick='() => activeTab = "cv"'>
            👥 İş Arayanlar Havuzu (@candidates.Count)
        </button>
    </div>

    @if (activeTab == "jobs")
    {
        <!-- Arama ve Filtreleme Çubuğu -->
        <div class="filters-panel">
            <!-- Pozisyon Butonları -->
            <div class="role-pills">
                <button class="pill @(selectedCategory == null ? "active" : "")" @onclick="() => selectedCategory = null">
                    Tümü (@postings.Count)
                </button>
                <button class="pill @(selectedCategory == JobRoleCategory.Waiter ? "active" : "")" @onclick="() => selectedCategory = JobRoleCategory.Waiter">
                    🍽️ Garsonlar
                </button>
                <button class="pill @(selectedCategory == JobRoleCategory.Busboy ? "active" : "")" @onclick="() => selectedCategory = JobRoleCategory.Busboy">
                    盆 Komiler
                </button>
                <button class="pill @(selectedCategory == JobRoleCategory.Housekeeping ? "active" : "")" @onclick="() => selectedCategory = JobRoleCategory.Housekeeping">
                    🧹 Temizlik & Kat Hizmetleri
                </button>
                <button class="pill @(selectedCategory == JobRoleCategory.FrontDesk ? "active" : "")" @onclick="() => selectedCategory = JobRoleCategory.FrontDesk">
                    🛎️ Resepsiyon & Ön Büro
                </button>
            </div>

            <!-- Şehir & Arama -->
            <div class="search-row">
                <div class="search-input-wrap">
                    <span class="icon">🔍</span>
                    <input type="text" placeholder="İlan başlığı, otel veya pozisyon ara..." @bind="searchQuery" @bind:event="oninput" />
                </div>

                <div class="select-wrap">
                    <select @bind="selectedCity">
                        <option value="">Tüm Şehirler</option>
                        <option value="Bodrum">Bodrum / Muğla</option>
                        <option value="Antalya">Antalya</option>
                        <option value="İstanbul">İstanbul</option>
                        <option value="Kapadokya">Kapadokya / Nevşehir</option>
                        <option value="Çeşme">Çeşme / İzmir</option>
                    </select>
                </div>

                <label class="checkbox-label">
                    <input type="checkbox" @bind="onlyWithAccommodation" />
                    <span>🏠 Sadece Lojman Sağlananlar</span>
                </label>
            </div>
        </div>

        <!-- İlan Listesi Grid -->
        <div class="job-cards-grid">
            @if (filteredPostings.Count == 0)
            {
                <div class="no-results-card">
                    <span class="icon">🔍</span>
                    <h3>Aradığınız kriterlere uygun ilan bulunamadı</h3>
                    <p>Filtreleri temizleyerek veya farklı bir şehir seçerek tekrar deneyebilirsiniz.</p>
                    <button class="btn-clear" @onclick="ClearFilters">Filtreleri Sıfırla</button>
                </div>
            }
            @foreach (var job in filteredPostings)
            {
                <div class="job-card">
                    <div class="job-card-top">
                        <div class="role-category-tag">
                            @GetRoleEmoji(job.Category) @job.PositionName
                        </div>
                        <span class="work-type-badge">@job.WorkType</span>
                    </div>

                    <h3 class="job-title">@job.Title</h3>

                    <div class="hotel-meta">
                        <span class="hotel-name">🏨 @(job.Hotel?.Name ?? "Lüks Resort Otel")</span>
                        <span class="location">📍 @job.City</span>
                    </div>

                    <div class="perks-row">
                        <div class="salary-tag">
                            💰 <b>@job.SalaryRange</b>
                        </div>
                        @if (job.AccommodationProvided)
                        {
                            <span class="perk-badge lodg">🏠 Lojman Var</span>
                        }
                        @if (job.MealsIncluded)
                        {
                            <span class="perk-badge meal">🍽️ 3 Öğün Yemek</span>
                        }
                    </div>

                    <p class="job-desc">@job.Description</p>

                    <div class="requirements-box">
                        <small><b>Aranan Nitelik:</b> @job.Requirements</small>
                    </div>

                    <div class="job-footer">
                        <div class="contact-info">
                            <small class="muted">İletişim:</small>
                            <a href="tel:@job.ContactPhone" class="phone-link">📞 @job.ContactPhone</a>
                        </div>
                        <button class="btn-apply" @onclick="() => OpenApplyModal(job)">
                            ⚡ Hızlı Başvuru Yap
                        </button>
                    </div>
                </div>
            }
        </div>
    }
    else if (activeTab == "applications")
    {
        <!-- Gelen Başvurular (Otel Yöneticileri ve İK Ekibi İçin) -->
        <div class="applications-section">
            <div class="section-sub-head">
                <div>
                    <h2>📥 Otellere Yapılan Personel Başvuruları</h2>
                    <p class="muted">Adayların iletişim bilgileri, lojman talepleri ve deneyim detayları. Durumu tek tıkla güncelleyebilirsiniz.</p>
                </div>
            </div>

            <div class="app-table-wrap">
                <table class="app-table">
                    <thead>
                        <tr>
                            <th>Aday Adı Soyadı</th>
                            <th>Başvurulan Pozisyon</th>
                            <th>Telefon & İletişim</th>
                            <th>Mevcut Şehir</th>
                            <th>Deneyim</th>
                            <th>Lojman Talebi</th>
                            <th>Başvuru Tarihi</th>
                            <th>Durum</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in applications)
                        {
                            <tr>
                                <td>
                                    <b>@app.FullName</b>
                                    @if (!string.IsNullOrWhiteSpace(app.Notes))
                                    {
                                        <div class="app-notes-tooltip" title="@app.Notes">
                                            📝 "@(app.Notes.Length > 45 ? app.Notes[..45] + "..." : app.Notes)"
                                        </div>
                                    }
                                </td>
                                <td>
                                    <span class="pos-badge">@app.RoleApplied</span>
                                </td>
                                <td>
                                    <a href="tel:@app.Phone" class="tel-btn">📞 @app.Phone</a>
                                    @if (!string.IsNullOrWhiteSpace(app.Email))
                                    {
                                        <div class="muted-small">@app.Email</div>
                                    }
                                </td>
                                <td>@app.CurrentCity</td>
                                <td>@app.ExperienceYears</td>
                                <td>
                                    @if (app.NeedsAccommodation)
                                    {
                                        <span class="badge-lojman-req">🏠 Lojman İstiyor</span>
                                    }
                                    else
                                    {
                                        <span class="badge-no-lojman">Kendi Evi</span>
                                    }
                                </td>
                                <td>@app.AppliedAt.ToString("dd.MM.yyyy")</td>
                                <td>
                                    <select class="status-select @GetStatusClass(app.Status)" @onchange="(e) => UpdateAppStatus(app, e.Value?.ToString() ?? app.Status)">
                                        <option value="Beklemede" selected="@(app.Status == "Beklemede")">Beklemede</option>
                                        <option value="Arandı" selected="@(app.Status == "Arandı")">Arandı</option>
                                        <option value="Mülakat" selected="@(app.Status == "Mülakat")">Mülakat</option>
                                        <option value="Onaylandı" selected="@(app.Status == "Onaylandı")">İşe Alındı</option>
                                    </select>
                                </td>
                                <td>
                                    <a href="tel:@app.Phone" class="btn-call-mini">Ara</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (activeTab == "cv")
    {
        <!-- İş Arayanlar Havuzu -->
        <div class="cv-pool-section">
            <div class="cv-hero-card">
                <div class="cv-form-wrap">
                    <h3>📝 İş Arıyorum — Profilini Otellere Bırak</h3>
                    <p class="muted">Otel sahipleri ve insan kaynakları doğrudan bu havuzu tarayarak sizi arasın.</p>

                    @if (candidateSubmitted)
                    {
                        <div class="cand-success">
                            🎉 <b>Profiliniz CV havuzuna eklendi!</b> Otel yöneticileri uygun pozisyon olduğunda sizinle iletişime geçecektir.
                        </div>
                    }

                    <div class="form-grid-2">
                        <div class="form-row">
                            <label>Adınız Soyadınız *</label>
                            <input type="text" placeholder="Örn: Hasan Yılmaz" @bind="newCand.FullName" />
                        </div>
                        <div class="form-row">
                            <label>Telefon Numaranız *</label>
                            <input type="tel" placeholder="+90 5xx xxx xx xx" @bind="newCand.Phone" />
                        </div>
                    </div>

                    <div class="form-grid-3">
                        <div class="form-row">
                            <label>İstediğiniz Pozisyon *</label>
                            <select @bind="newCand.PreferredRole">
                                <option value="Garson">🍽️ Garson</option>
                                <option value="Komi">盆 Komi</option>
                                <option value="Temizlik Görevlisi">🧹 Kat Hizmetleri / Temizlik</option>
                                <option value="Resepsiyonist">🛎️ Resepsiyonist</option>
                                <option value="Aşçı">👨‍🍳 Aşçı / Mutfak</option>
                                <option value="Barmen">🍹 Barmen</option>
                            </select>
                        </div>
                        <div class="form-row">
                            <label>Yaşadığınız Şehir</label>
                            <input type="text" placeholder="Örn: İzmir, Aydın, Muğla" @bind="newCand.City" />
                        </div>
                        <div class="form-row">
                            <label>Deneyim Durumu</label>
                            <select @bind="newCand.ExperienceYears">
                                <option value="Yetiştirilmek Üzere">Yetiştirilmek Üzere</option>
                                <option value="1 Yıl">1 Yıl</option>
                                <option value="2-3 Yıl">2-3 Yıl</option>
                                <option value="4+ Yıl">4+ Yıl (Usta)</option>
                            </select>
                        </div>
                    </div>

                    <div class="checkbox-row">
                        <label class="checkbox-label">
                            <input type="checkbox" @bind="newCand.NeedsAccommodation" />
                            <span>🏠 Yatılı / Lojmanlı çalışmak istiyorum</span>
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" @bind="newCand.ReadyImmediate" />
                            <span>⚡ Hemen bugün iş başı yapabilirim</span>
                        </label>
                    </div>

                    <div class="form-row">
                        <label>Hakkınızda Kısa Bilgi & Referanslar</label>
                        <textarea rows="2" placeholder="Daha önce çalıştığınız oteller, bildiğiniz yabancı diller veya notunuz..." @bind="newCand.Note"></textarea>
                    </div>

                    <button class="btn-primary-large" @onclick="SubmitCandidateProfile">
                        🚀 Profilimi Otellerle Paylaş
                    </button>
                </div>
            </div>

            <!-- Kayıtlı Adaylar Listesi -->
            <h3 style="margin: 40px 0 16px;">👥 Havuzdaki İş Arayan Adaylar (@candidates.Count)</h3>
            <div class="candidates-grid">
                @foreach (var c in candidates)
                {
                    <div class="cand-card">
                        <div class="cand-header">
                            <div>
                                <b>@c.FullName</b>
                                <div class="cand-role">🎯 @c.PreferredRole</div>
                            </div>
                            <span class="cand-city">📍 @c.City</span>
                        </div>
                        <div class="cand-tags">
                            <span class="tag-exp">⏱️ @c.ExperienceYears</span>
                            @if (c.NeedsAccommodation)
                            {
                                <span class="tag-loj">🏠 Lojman Talebi Var</span>
                            }
                            @if (c.ReadyImmediate)
                            {
                                <span class="tag-ready">⚡ Hemen Başlayabilir</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(c.Note))
                        {
                            <p class="cand-note">"@c.Note"</p>
                        }
                        <div class="cand-footer">
                            <a href="tel:@c.Phone" class="btn-call">📞 @c.Phone</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- Hızlı Başvuru Yap Modalı -->
@if (showApplyModal && selectedJob != null)
{
    <div class="modal-backdrop" @onclick="() => showApplyModal = false">
        <div class="modal-card" @onclick:stopPropagation>
            <div class="modal-head">
                <div>
                    <h3>⚡ Hızlı Başvuru: @selectedJob.PositionName</h3>
                    <p class="muted-small">@(selectedJob.Hotel?.Name ?? "Otel") · @selectedJob.City</p>
                </div>
                <button class="close-btn" @onclick="() => showApplyModal = false">✕</button>
            </div>

            <div class="modal-body">
                @if (applySuccess)
                {
                    <div class="cand-success" style="padding:24px;text-align:center">
                        <span style="font-size:3rem;display:block;margin-bottom:10px">🎉</span>
                        <h4>Başvurunuz Otel Yönetimine İletildi!</h4>
                        <p>Sayın <b>@applyName</b>, başvurunuz <b>@(selectedJob.Hotel?.Name)</b> İnsan Kaynakları yetkilisine teslim edilmiştir. En kısa sürede <b>@applyPhone</b> numaranız aranacaktır.</p>
                        <button class="btn-primary-large" style="margin-top:16px" @onclick="() => showApplyModal = false">Tamam</button>
                    </div>
                }
                else
                {
                    <div class="salary-highlight">
                        💰 Maaş: <b>@selectedJob.SalaryRange</b> | 🏠 Lojman: @(selectedJob.AccommodationProvided ? "Sağlanır" : "Yok")
                    </div>

                    <div class="form-row">
                        <label>Adınız Soyadınız *</label>
                        <input type="text" placeholder="Adınız ve Soyadınız" @bind="applyName" />
                    </div>

                    <div class="form-grid-2">
                        <div class="form-row">
                            <label>Telefon Numaranız *</label>
                            <input type="tel" placeholder="+90 5xx xxx xx xx" @bind="applyPhone" />
                        </div>
                        <div class="form-row">
                            <label>Şu An Bulunduğunuz Şehir</label>
                            <input type="text" placeholder="Örn: İzmir, Muğla, Antalya" @bind="applyCity" />
                        </div>
                    </div>

                    <div class="form-grid-2">
                        <div class="form-row">
                            <label>Bu Alandaki Deneyiminiz</label>
                            <select @bind="applyExp">
                                <option value="Yetiştirilmek Üzere">Yetiştirilmek Üzere (Deneyimsiz)</option>
                                <option value="1 Sezon">1 Sezon / 1 Yıl</option>
                                <option value="2-3 Yıl">2-3 Yıl</option>
                                <option value="4+ Yıl">4+ Yıl (Usta Personel)</option>
                            </select>
                        </div>
                        <div class="form-row">
                            <label>Lojman (Yatılı) İstiyor musunuz?</label>
                            <select @bind="applyLojman">
                                <option value="true">Evet, Lojman İstiyorum</option>
                                <option value="false">Hayır, Kendi Evimde Kalacağım</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-row">
                        <label>Kendinizi Tanıtın / Notunuz</label>
                        <textarea rows="3" placeholder="Daha önce çalıştığınız oteller, başlangıç yapabileceğiniz tarih vb..." @bind="applyNotes"></textarea>
                    </div>

                    <button class="btn-primary-large" style="width:100%;margin-top:12px" @onclick="SubmitApplication">
                        🚀 Başvurumu Otele Gönder
                    </button>
                }
            </div>
        </div>
    </div>
}

<!-- Yeni İlan Verme Modalı (Otel Yöneticileri İçin) -->
@if (showNewJobModal)
{
    <div class="modal-backdrop" @onclick="() => showNewJobModal = false">
        <div class="modal-card" @onclick:stopPropagation>
            <div class="modal-head">
                <h3>🏨 Yeni Personel İlanı Yayınla</h3>
                <button class="close-btn" @onclick="() => showNewJobModal = false">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-row">
                    <label>İlan Başlığı *</label>
                    <input type="text" placeholder="Örn: A la Carte Restoran Garsonu" @bind="newJobTitle" />
                </div>

                <div class="form-grid-2">
                    <div class="form-row">
                        <label>Pozisyon Kategorisi *</label>
                        <select @bind="newJobCategory">
                            <option value="@JobRoleCategory.Waiter">Garson (Servis)</option>
                            <option value="@JobRoleCategory.Busboy">Komi (Garson Yardımcısı)</option>
                            <option value="@JobRoleCategory.Housekeeping">Temizlik / Kat Hizmetleri</option>
                            <option value="@JobRoleCategory.FrontDesk">Ön Büro / Resepsiyon</option>
                            <option value="@JobRoleCategory.Kitchen">Mutfak & Aşçı</option>
                            <option value="@JobRoleCategory.Bartender">Barmen / Barista</option>
                        </select>
                    </div>
                    <div class="form-row">
                        <label>Şehir / Konum *</label>
                        <input type="text" placeholder="Örn: Bodrum / Muğla" @bind="newJobCity" />
                    </div>
                </div>

                <div class="form-grid-2">
                    <div class="form-row">
                        <label>Maaş Aralığı *</label>
                        <input type="text" placeholder="Örn: 32.000 ₺ - 38.000 ₺ + Tip" @bind="newJobSalary" />
                    </div>
                    <div class="form-row">
                        <label>Çalışma Şekli</label>
                        <input type="text" placeholder="Örn: Sezonluk (Mayıs - Ekim)" @bind="newJobWorkType" />
                    </div>
                </div>

                <div class="checkbox-row" style="margin-bottom:14px">
                    <label class="checkbox-label">
                        <input type="checkbox" @bind="newJobLojman" />
                        <span>🏠 Lojman Sağlanır</span>
                    </label>
                    <label class="checkbox-label">
                        <input type="checkbox" @bind="newJobMeals" />
                        <span>🍽️ 3 Öğün Yemek Dahil</span>
                    </label>
                </div>

                <div class="form-row">
                    <label>İş Tanımı</label>
                    <textarea rows="2" placeholder="Görev ve sorumluluklar..." @bind="newJobDesc"></textarea>
                </div>

                <div class="form-row">
                    <label>İletişim Telefon Numarası *</label>
                    <input type="tel" placeholder="+90 252 555 xx xx" @bind="newJobPhone" />
                </div>

                <button class="btn-primary-large" style="width:100%;margin-top:12px" @onclick="SubmitNewJobPosting">
                    ➕ İlanı Hemen Yayınla
                </button>
            </div>
        </div>
    </div>
}

<style>
.jobs-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 30px 20px 80px;
    color: #f1f5f9;
}
.jobs-hero {
    text-align: center;
    padding: 10px 0 30px;
}
.jobs-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    border-radius: 999px;
    background: hsla(217, 91%, 60%, 0.12);
    border: 1px solid hsla(217, 91%, 60%, 0.3);
    color: #38bdf8;
    font-size: 0.88rem;
    font-weight: 600;
    margin-bottom: 16px;
}
.pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #38bdf8;
    box-shadow: 0 0 10px #38bdf8;
}
.jobs-hero h1 {
    font-size: 2.6rem;
    line-height: 1.25;
    margin-bottom: 14px;
    font-weight: 800;
}
.gradient-text {
    background: linear-gradient(135deg, #38bdf8 0%, #2dd4bf 50%, #f59e0b 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}
.hero-desc {
    font-size: 1.1rem;
    color: #94a3b8;
    max-width: 760px;
    margin: 0 auto 26px;
    line-height: 1.6;
}
.hero-stats-row {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
    margin-top: 10px;
}
.stat-box {
    background: hsla(222, 47%, 14%, 0.9);
    border: 1px solid hsla(217, 33%, 24%, 0.8);
    border-radius: 14px;
    padding: 10px 22px;
    display: flex;
    flex-direction: column;
    align-items: center;
}
.stat-box .num {
    font-size: 1.6rem;
    font-weight: 800;
    color: #2dd4bf;
}
.stat-box .lbl {
    font-size: 0.8rem;
    color: #94a3b8;
}
.hero-actions {
    display: flex;
    gap: 12px;
    margin-left: 10px;
}
.btn-post-job {
    background: linear-gradient(135deg, #0ea5e9, #0d9488);
    color: #fff;
    border: none;
    padding: 12px 20px;
    border-radius: 12px;
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    transition: all 0.2s;
}
.btn-post-job:hover {
