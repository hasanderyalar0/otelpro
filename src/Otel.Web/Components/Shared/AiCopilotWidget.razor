@code {
    bool isOpen = false;
    bool isThinking = false;
    bool isListening = false;
    string userInput = "";
    string activeTab = "guest";
    ElementReference chatBody;
    DotNetObjectReference<AiCopilotWidget>? dotNetRef;

    // Sohbet geçmişi AiCopilotService (Scoped) içinde saklanır; kapatılınca veya sayfa değişince ASLA silinmez!
    List<CopilotMessage> messages => Copilot.History;

    protected override void OnInitialized()
    {
        if (Copilot.History.Count == 0)
        {
            ResetWelcomeMessage();
        }
    }

    void ResetWelcomeMessage()
    {
        string hotelName = CurrentHotelState.SelectedHotel?.Name ?? "Grand Aegean Resort";
        Copilot.ClearHistory();
        Copilot.AddMessage(new(
            "assistant",
            $"Merhaba! Ben **{hotelName} 7/24 Yapay Zeka Rehberiniz & Operasyon Copilotu** 🤖\n\n" +
            $"Size ve misafirlerimize nasıl yardımcı olabilirim? İster klavyeden yazın, ister 🎙️ mikrofon butonuna basarak doğrudan Türkçe konuşun! Sorularınızı doğal ve akıcı sesli asistanımla yanıtlayabilirim.",
            DateTime.Now,
            Actions: new List<CopilotAction>
            {
                new("🛎️ Hemen Online Rezervasyon Yap", "/book", "En İyi Fiyat"),
                new("🌴 Çevre & Aktiviteleri Keşfet", "/nearby", "Aktivite Rehberi"),
                new("📊 Yönetici & Operasyon Paneli", "/", "Yönetim"),
                new("👨‍🍳 Kariyer & Personel Başvurusu", "/jobs", "İş İlanları")
            }
        ));
    }

    void ClearChat()
    {
        ResetWelcomeMessage();
        _ = JS.InvokeVoidAsync("OtelVoice.clearHistory");
    }

    void ToggleDrawer()
    {
        isOpen = !isOpen;
    }

    void CloseDrawer()
    {
        isOpen = false;
        // Kapatıldığında sohbet ASLA silinmez!
        if (isListening)
        {
            _ = JS.InvokeVoidAsync("OtelVoice.stopListening");
            isListening = false;
        }
    }

    void SetTab(string tab)
    {
        activeTab = tab;
    }

    async Task ToggleVoiceInput()
    {
        if (isListening)
        {
            await JS.InvokeVoidAsync("OtelVoice.stopListening");
            isListening = false;
            // Kullanıcı mikrofonu kapattığında söylenen metin silinmez, hemen gönderilir ve cevaplanır!
            if (!string.IsNullOrWhiteSpace(userInput))
            {
                await SendMessage(autoSpeak: true);
            }
        }
        else
        {
            dotNetRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("OtelVoice.startListening", dotNetRef, "tr-TR");
        }
    }

    [JSInvokable]
    public async Task OnSpeechResult(string text, bool isFinal)
    {
        if (!string.IsNullOrWhiteSpace(text))
        {
            userInput = text;
        }

        if (isFinal)
        {
            isListening = false;
            await SendMessage(autoSpeak: true);
        }
        else
        {
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void OnSpeechStart()
    {
        isListening = true;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnSpeechEnd()
    {
        isListening = false;
        // Mikrofon konuşma bittiğinde kapandığında metin kaybolmasın, otomatik gönderilip seslendirilsin!
        if (!string.IsNullOrWhiteSpace(userInput) && !isThinking)
        {
            await SendMessage(autoSpeak: true);
        }
        else
        {
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void OnSpeechError(string error)
    {
        isListening = false;
        StateHasChanged();
    }

    async Task SpeakMessage(string content)
    {
        await JS.InvokeVoidAsync("OtelVoice.speakText", content, "tr-TR");
    }

    async Task SendQuickQuery(string query)
    {
        userInput = query;
        await SendMessage(autoSpeak: false);
    }

    Task SendMessage() => SendMessage(false);

    async Task SendMessage(bool autoSpeak = false)
    {
        if (string.IsNullOrWhiteSpace(userInput) || isThinking) return;

        var q = userInput.Trim();
        userInput = "";

        Copilot.AddMessage(new CopilotMessage("user", q, DateTime.Now));
        isThinking = true;
        StateHasChanged();

        try
        {
            int hId = CurrentHotelState.SelectedHotelId > 0 ? CurrentHotelState.SelectedHotelId : 1;
            var reply = await Copilot.ProcessQueryAsync(q, hId, activeTab);
            Copilot.AddMessage(reply);

            // Sesli konuşma ile sorulduğunda cevabı doğrudan sesli asistanla seslendir!
            if (autoSpeak)
            {
                _ = SpeakMessage(reply.Content);
            }
        }
        catch (Exception ex)
        {
            Copilot.AddMessage(new CopilotMessage(
                "assistant",
                $"Sorunuzu işlerken bir sorun oluştu: {ex.Message}. Lütfen tekrar deneyin.",
                DateTime.Now,
                Actions: new List<CopilotAction>
                {
                    new("🛎️ Rezervasyon Sayfası", "/book"),
                    new("📊 Yönetim Paneli", "/")
                }
            ));
        }
        finally
        {
            isThinking = false;
            StateHasChanged();
        }
    }

    void NavigateTo(string url)
    {
        CloseDrawer();
        Nav.NavigateTo(url);
    }

    string FormatMessage(string input)
    {
        if (string.IsNullOrEmpty(input)) return "";
        return input
            .Replace("\n", "<br/>")
            .Replace("**", "<b>")
            .Replace("•", "<span style='color:#38bdf8'>•</span>");
    }

    public void Dispose()
    {
        dotNetRef?.Dispose();
    }
}
